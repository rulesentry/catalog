{
  "$schema": "https://schemas.rulesentry.io/v5/catalog/rule.schema.json",
  "id": "contact.city_state_zip",
  "qualified_id": "rulesentry.contact.city_state_zip",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "4.0.0",
  "name": "City, State, ZIP (US Format)",
  "description": "Detects US-style city, state, ZIP combinations (e.g., San Francisco, CA 94102).\n\nFormat: City, ST XXXXX",
  "category_id": "contact",
  "severity": "low",
  "profiles": [
    "ccpa",
    "production"
  ],
  "evaluation": {
    "evaluation_type": "pattern_match",
    "priority": 55,
    "target": "content",
    "pattern": {
      "pattern": "\\b[A-Z][a-z]+(?:\\s+[A-Z][a-z]+)*,\\s+[A-Z]{2}\\s+\\d{5}(?:-\\d{4})?\\b",
      "engine": "regex"
    },
    "effect": {
      "type": "transform",
      "rationale": "inference",
      "transform": {
        "type": "redact",
        "params": {
          "marker": "[CITY_STATE_ZIP]"
        }
      },
      "message": "City, state, ZIP redacted"
    }
  },
  "status": "active",
  "created_at": "2026-01-27T00:00:00Z",
  "regions": [
    "US"
  ],
  "references": [
    {
      "note": "Based on OpenRedaction community patterns"
    },
    {
      "url": "https://github.com/openredact/openredact"
    }
  ],
  "modified_at": "2026-01-27T19:52:26.946580Z"
}
