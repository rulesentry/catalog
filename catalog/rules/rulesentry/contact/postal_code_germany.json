{
  "$schema": "https://schemas.rulesentry.io/v5/catalog/rule.schema.json",
  "id": "contact.postal_code_germany",
  "qualified_id": "rulesentry.contact.postal_code_germany",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "4.0.0",
  "name": "German Postal Code",
  "description": "Detects German postal codes (5 digits).\n\nFormat: XXXXX",
  "category_id": "contact",
  "severity": "low",
  "profiles": [
    "gdpr",
    "production"
  ],
  "evaluation": {
    "evaluation_type": "pattern_match",
    "priority": 60,
    "target": "content",
    "pattern": {
      "pattern": "\\b\\d{5}\\b",
      "engine": "regex"
    },
    "effect": {
      "type": "transform",
      "rationale": "verification",
      "transform": {
        "type": "tokenize",
        "params": {
          "prefix": "POSTAL",
          "reversible": false
        }
      },
      "message": "German postal code tokenized, region digits visible for de-identification"
    }
  },
  "status": "active",
  "created_at": "2026-01-27T00:00:00Z",
  "regions": [
    "DE"
  ],
  "references": [
    {
      "note": "Based on OpenRedaction community patterns"
    },
    {
