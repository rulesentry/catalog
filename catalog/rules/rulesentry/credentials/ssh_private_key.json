{
  "$schema": "https://schemas.rulesentry.io/v5/catalog/rule.schema.json",
  "id": "credentials.ssh_private_key",
  "qualified_id": "rulesentry.credentials.ssh_private_key",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "4.0.0",
  "status": "deprecated",
  "name": "SSH Private Key",
  "summary": "Detects SSH private keys in RSA, DSA, EC, and OPENSSH formats",
  "description": "Detects SSH private keys (RSA, DSA, EC, OPENSSH formats). Exposure allows unauthorized SSH access to servers.\n\nFormats: BEGIN RSA PRIVATE KEY, BEGIN DSA PRIVATE KEY, BEGIN EC PRIVATE KEY, BEGIN OPENSSH PRIVATE KEY\nRisk: Server compromise, unauthorized SSH access",
  "category_id": "credentials",
  "severity": "critical",
  "profiles": [
    "production"
  ],
  "regions": [
    "GLOBAL"
  ],
  "tags": [
    "secret",
    "ssh",
    "private-key",
    "credential"
  ],
  "evaluation": {
    "evaluation_type": "pattern_match",
    "priority": 100,
    "target": "content",
    "pattern": {
      "pattern": "-----BEGIN (?:RSA |DSA |EC |OPENSSH )?PRIVATE KEY-----[\\s\\S]*?-----END (?:RSA |DSA |EC |OPENSSH )?PRIVATE KEY-----",
      "engine": "regex"
    },
    "effect": {
      "type": "transform",
      "rationale": "compliance",
      "message": "SSH Private Key redacted (critical security risk)",
      "transform": {
        "type": "redact",
        "params": {
          "marker": "[SSH_PRIVATE_KEY]"
        }
      }
    }
  },
  "created_at": "2026-02-10T00:00:00Z",
  "references": [
    {
      "note": "Based on OpenRedaction community patterns"
    },
    {
      "url": "https://github.com/openredact/openredact"
    }
  ],
  "modified_at": "2026-04-18T00:00:00Z"
}
