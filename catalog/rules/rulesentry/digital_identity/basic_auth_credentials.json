{
  "$schema": "https://schemas.rulesentry.io/v5/catalog/rule.schema.json",
  "id": "digital_identity.basic_auth_credentials",
  "qualified_id": "rulesentry.digital_identity.basic_auth_credentials",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "4.0.0",
  "name": "HTTP Basic Auth Credentials",
  "description": "Detects HTTP Basic Authentication credentials in Authorization headers. Format: Basic [base64]. Contains username:password.\n\nFormat: Basic [base64-encoded username:password]\nRisk: Plain credentials exposure",
  "category_id": "digital_identity",
  "severity": "critical",
  "profiles": [
    "technology-sector",
    "production"
  ],
  "evaluation": {
    "evaluation_type": "pattern_match",
    "priority": 90,
    "target": "content",
    "pattern": {
      "pattern": "\\bBasic\\s+[A-Za-z0-9+/=]{12,}\\b",
      "engine": "regex",
      "flags": {
        "case_insensitive": true
      }
    },
    "effect": {
      "type": "transform",
      "rationale": "compliance",
      "transform": {
        "type": "redact",
        "params": {
          "marker": "[BASIC_AUTH_CREDENTIALS]"
        }
      },
      "message": "HTTP Basic Auth credentials redacted - redacted"
    }
  },
  "status": "active",
  "created_at": "2026-01-27T00:00:00Z",
  "regions": [
    "GLOBAL"
  ],
  "references": [
    {
      "note": "Based on OpenRedaction community patterns"
    },
    {
      "url": "https://github.com/openredact/openredact"
    }
  ],
  "modified_at": "2026-03-21T00:00:00Z"
}
