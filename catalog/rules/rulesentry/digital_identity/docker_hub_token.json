{
  "$schema": "https://schemas.rulesentry.io/v5/catalog/rule.schema.json",
  "id": "digital_identity.docker_hub_token",
  "qualified_id": "rulesentry.digital_identity.docker_hub_token",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "4.0.0",
  "name": "Docker Hub Access Token",
  "description": "Detects Docker Hub personal access tokens. Can push/pull images, modify repositories.\n\nFormat: dckr_pat_[A-Za-z0-9_-]{32,}\nRisk: Container registry access, image tampering",
  "category_id": "digital_identity",
  "severity": "high",
  "profiles": [
    "technology-sector",
    "production"
  ],
  "evaluation": {
    "evaluation_type": "pattern_match",
    "priority": 85,
    "target": "content",
    "pattern": {
      "pattern": "\\bdckr_pat_[A-Za-z0-9_-]{32,}\\b",
      "engine": "regex"
    },
    "effect": {
      "type": "transform",
      "rationale": "compliance",
      "transform": {
        "type": "redact",
        "params": {
          "marker": "[DOCKER_HUB_TOKEN]"
        }
      },
      "message": "Docker Hub Token redacted - redacted"
    }
  },
  "status": "active",
  "created_at": "2026-01-27T00:00:00Z",
  "regions": [
    "GLOBAL"
  ],
  "references": [
    {
      "note": "Based on OpenRedaction community patterns"
    },
    {
      "url": "https://github.com/openredact/openredact"
    }
  ],
  "modified_at": "2026-03-21T00:00:00Z"
}
