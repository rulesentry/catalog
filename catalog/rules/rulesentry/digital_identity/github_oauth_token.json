{
  "$schema": "https://schemas.rulesentry.io/v5/catalog/rule.schema.json",
  "id": "digital_identity.github_oauth_token",
  "qualified_id": "rulesentry.digital_identity.github_oauth_token",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "4.0.0",
  "name": "GitHub OAuth Access Token",
  "description": "Detects GitHub OAuth access tokens. Format: gho_ prefix. Used by GitHub Apps and OAuth Apps.\n\nFormat: gho_[A-Za-z0-9_]{36}\nRisk: GitHub App/OAuth compromise",
  "category_id": "digital_identity",
  "severity": "critical",
  "profiles": [
    "technology-sector",
    "production"
  ],
  "evaluation": {
    "evaluation_type": "pattern_match",
    "priority": 95,
    "target": "content",
    "pattern": {
      "pattern": "\\bgho_[A-Za-z0-9_]{36}\\b",
      "engine": "regex"
    },
    "effect": {
      "type": "transform",
      "rationale": "compliance",
      "transform": {
        "type": "redact",
        "params": {
          "marker": "[GITHUB_OAUTH_TOKEN]"
        }
      },
      "message": "GitHub OAuth Token redacted - redacted"
    }
  },
  "status": "active",
  "created_at": "2026-01-27T00:00:00Z",
  "regions": [
    "GLOBAL"
  ],
  "references": [
    {
      "note": "Based on OpenRedaction community patterns"
    },
    {
      "url": "https://github.com/openredact/openredact"
    }
  ],
  "modified_at": "2026-03-21T00:00:00Z"
}
