{
  "$schema": "https://schemas.rulesentry.io/v5/catalog/rule.schema.json",
  "id": "digital_identity.google_oauth_client_secret",
  "qualified_id": "rulesentry.digital_identity.google_oauth_client_secret",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "4.0.0",
  "name": "Google OAuth Client Secret",
  "description": "Detects Google OAuth 2.0 client secrets. Used for server-to-server authentication with Google services.\n\nRisk: OAuth flow compromise, unauthorized Google service access",
  "category_id": "digital_identity",
  "severity": "critical",
  "profiles": [
    "technology-sector",
    "production"
  ],
  "evaluation": {
    "evaluation_type": "pattern_match",
    "priority": 95,
    "target": "content",
    "pattern": {
      "pattern": "\\b(?:client_secret|GOOGLE_CLIENT_SECRET)[:\\s=]+([A-Za-z0-9_-]{24,})\\b",
      "engine": "regex",
      "flags": {
        "capture_groups": true
      }
    },
    "effect": {
      "type": "transform",
      "rationale": "compliance",
      "transform": {
        "type": "redact",
        "params": {
          "marker": "[GOOGLE_OAUTH_CLIENT_SECRET]"
        }
      },
      "message": "Google OAuth Client Secret redacted - redacted"
    }
  },
  "status": "active",
  "created_at": "2026-01-27T00:00:00Z",
  "regions": [
    "GLOBAL"
  ],
  "references": [
    {
      "note": "Based on OpenRedaction community patterns"
    },
    {
      "url": "https://github.com/openredact/openredact"
    }
  ],
  "modified_at": "2026-04-18T00:00:00Z"
}
