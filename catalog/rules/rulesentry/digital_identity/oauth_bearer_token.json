{
  "$schema": "https://schemas.rulesentry.io/v5/catalog/rule.schema.json",
  "id": "digital_identity.oauth_bearer_token",
  "qualified_id": "rulesentry.digital_identity.oauth_bearer_token",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "4.0.0",
  "name": "OAuth Bearer Token",
  "description": "Detects OAuth 2.0 Bearer tokens in Authorization headers. Format: Bearer [token]. Used for API authentication.\n\nFormat: Bearer [A-Za-z0-9_-]+\nRisk: API access, session hijacking",
  "category_id": "digital_identity",
  "severity": "high",
  "profiles": [
    "technology-sector",
    "production"
  ],
  "evaluation": {
    "evaluation_type": "pattern_match",
    "priority": 85,
    "target": "content",
    "pattern": {
      "pattern": "\\bBearer\\s+[A-Za-z0-9_\\-\\.=]+\\b",
      "engine": "regex",
      "flags": {
        "case_insensitive": true
      }
    },
    "effect": {
      "type": "transform",
      "rationale": "verification",
      "transform": {
        "type": "tokenize",
        "params": {
          "prefix": "OAUTH_TOKEN",
          "reversible": true
        }
      },
      "message": "OAuth Bearer token tokenized for de-identification"
    }
  },
  "status": "active",
  "created_at": "2026-01-27T00:00:00Z",
  "regions": [
    "GLOBAL"
  ],
  "references": [
    {
      "note": "Based on OpenRedaction community patterns"
    },
    {
      "url": "https://github.com/openredact/openredact"
    }
  ],
  "modified_at": "2026-03-21T00:00:00Z"
}
