{
  "$schema": "https://schemas.rulesentry.io/v5/catalog/rule.schema.json",
  "id": "digital_identity.paypal_client_secret",
  "qualified_id": "rulesentry.digital_identity.paypal_client_secret",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "4.0.0",
  "name": "PayPal Client Secret",
  "description": "Detects PayPal REST API client secrets. Used with client ID for PayPal payment processing.\n\nFormat: EP[A-Za-z0-9_-]{30,}\nRisk: Payment processing access, financial fraud",
  "category_id": "digital_identity",
  "severity": "critical",
  "profiles": [
    "technology-sector",
    "production",
    "pci-dss"
  ],
  "evaluation": {
    "evaluation_type": "pattern_match",
    "priority": 95,
    "target": "content",
    "pattern": {
      "pattern": "\\bEP[A-Za-z0-9_-]{30,}\\b",
      "engine": "regex"
    },
    "effect": {
      "type": "transform",
      "rationale": "compliance",
      "transform": {
        "type": "redact",
        "params": {
          "marker": "[PAYPAL_CLIENT_SECRET]"
        }
      },
      "message": "PayPal Client Secret redacted - redacted (financial security risk)"
    }
  },
  "status": "active",
  "created_at": "2026-01-27T00:00:00Z",
  "regions": [
    "GLOBAL"
  ],
  "references": [
    {
      "note": "Based on OpenRedaction community patterns"
    },
    {
      "url": "https://github.com/openredact/openredact"
    }
  ],
  "modified_at": "2026-03-21T00:00:00Z"
}
