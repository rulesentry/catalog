{
  "$schema": "https://schemas.rulesentry.io/v5/catalog/rule.schema.json",
  "id": "digital_identity.pgp_private_key",
  "qualified_id": "rulesentry.digital_identity.pgp_private_key",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "4.0.0",
  "name": "PGP Private Key",
  "description": "Detects PGP/GPG private keys. Exposure allows decryption of encrypted messages and digital signature forgery.\n\nFormat: BEGIN PGP PRIVATE KEY BLOCK\nRisk: Message decryption, signature forgery",
  "category_id": "digital_identity",
  "severity": "critical",
  "profiles": [
    "technology-sector",
    "production"
  ],
  "evaluation": {
    "evaluation_type": "pattern_match",
    "priority": 100,
    "target": "content",
    "pattern": {
      "pattern": "-----BEGIN PGP PRIVATE KEY BLOCK-----[\\s\\S]*?-----END PGP PRIVATE KEY BLOCK-----",
      "engine": "regex"
    },
    "effect": {
      "type": "transform",
      "rationale": "compliance",
      "transform": {
        "type": "redact",
        "params": {
          "marker": "[PGP_PRIVATE_KEY]"
        }
      },
      "message": "PGP Private Key redacted - redacted (critical security risk)"
    }
  },
  "status": "active",
  "created_at": "2026-01-27T00:00:00Z",
  "regions": [
    "GLOBAL"
  ],
  "references": [
    {
      "note": "Based on OpenRedaction community patterns"
    },
    {
      "url": "https://github.com/openredact/openredact"
    }
  ],
  "modified_at": "2026-04-18T00:00:00Z"
}
