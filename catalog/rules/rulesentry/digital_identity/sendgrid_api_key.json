{
  "$schema": "https://schemas.rulesentry.io/v5/catalog/rule.schema.json",
  "id": "digital_identity.sendgrid_api_key",
  "qualified_id": "rulesentry.digital_identity.sendgrid_api_key",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "4.0.0",
  "name": "SendGrid API Key",
  "description": "Detects SendGrid email API keys. Format: SG. followed by base64. Can send emails, access contact lists.\n\nFormat: SG.[A-Za-z0-9_-]{22,}\nRisk: Email spam, phishing campaigns",
  "category_id": "digital_identity",
  "severity": "high",
  "profiles": [
    "technology-sector",
    "production"
  ],
  "evaluation": {
    "evaluation_type": "pattern_match",
    "priority": 85,
    "target": "content",
    "pattern": {
      "pattern": "\\bSG\\.[A-Za-z0-9_-]{22,}\\b",
      "engine": "regex"
    },
    "effect": {
      "type": "transform",
      "rationale": "compliance",
      "transform": {
        "type": "redact",
        "params": {
          "marker": "[SENDGRID_API_KEY]"
        }
      },
      "message": "SendGrid API Key redacted - redacted"
    }
  },
  "status": "active",
  "created_at": "2026-01-27T00:00:00Z",
  "regions": [
    "GLOBAL"
  ],
  "references": [
    {
      "note": "Based on OpenRedaction community patterns"
    },
    {
      "url": "https://github.com/openredact/openredact"
    }
  ],
  "modified_at": "2026-03-21T00:00:00Z"
}
