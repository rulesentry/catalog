{
  "$schema": "https://schemas.rulesentry.io/v5/catalog/rule.schema.json",
  "id": "digital_identity.slack_bot_token",
  "qualified_id": "rulesentry.digital_identity.slack_bot_token",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "4.0.0",
  "name": "Slack Bot Token",
  "description": "Detects Slack Bot tokens. Format: xoxb-. Can read messages, post messages, access workspace data.\n\nFormat: xoxb-[0-9]+-[0-9]+-[A-Za-z0-9]+\nRisk: Workspace data access, message reading/posting",
  "category_id": "digital_identity",
  "severity": "high",
  "profiles": [
    "technology-sector",
    "production"
  ],
  "evaluation": {
    "evaluation_type": "pattern_match",
    "priority": 85,
    "target": "content",
    "pattern": {
      "pattern": "\\bxoxb-[0-9]+-[0-9]+-[A-Za-z0-9]+\\b",
      "engine": "regex"
    },
    "effect": {
      "type": "transform",
      "rationale": "compliance",
      "transform": {
        "type": "redact",
        "params": {
          "marker": "[SLACK_BOT_TOKEN]"
        }
      },
      "message": "Slack Bot Token redacted - redacted"
    }
  },
  "status": "active",
  "created_at": "2026-01-27T00:00:00Z",
  "regions": [
    "GLOBAL"
  ],
  "references": [
    {
      "note": "Based on OpenRedaction community patterns"
    },
    {
      "url": "https://github.com/openredact/openredact"
    }
  ],
  "modified_at": "2026-03-21T00:00:00Z"
}
