{
  "$schema": "https://schemas.rulesentry.io/v5/catalog/rule.schema.json",
  "id": "digital_identity.ssh_private_key",
  "qualified_id": "rulesentry.digital_identity.ssh_private_key",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "4.0.0",
  "name": "SSH Private Key",
  "description": "Detects SSH private keys (RSA, DSA, EC, OPENSSH formats). Exposure allows unauthorized SSH access to servers.\n\nFormats: BEGIN RSA PRIVATE KEY, BEGIN DSA PRIVATE KEY, BEGIN EC PRIVATE KEY, BEGIN OPENSSH PRIVATE KEY\nRisk: Server compromise, unauthorized SSH access\n\nNote: Canonical SSH private key rule as of v4.0. credentials.ssh_private_key is deprecated and will be removed in v4.1.",
  "category_id": "digital_identity",
  "severity": "critical",
  "profiles": [
    "technology-sector",
    "production"
  ],
  "evaluation": {
    "evaluation_type": "pattern_match",
    "priority": 100,
    "target": "content",
    "pattern": {
      "pattern": "-----BEGIN (?:RSA |DSA |EC |OPENSSH )?PRIVATE KEY-----[\\s\\S]*?-----END (?:RSA |DSA |EC |OPENSSH )?PRIVATE KEY-----",
      "engine": "regex"
    },
    "effect": {
      "type": "transform",
      "rationale": "compliance",
      "transform": {
        "type": "redact",
        "params": {
          "marker": "[SSH_PRIVATE_KEY]"
        }
      },
      "message": "SSH Private Key redacted - redacted (critical security risk)"
    }
  },
  "status": "active",
  "created_at": "2026-01-27T00:00:00Z",
  "regions": [
    "GLOBAL"
  ],
  "references": [
    {
      "note": "Based on OpenRedaction community patterns"
    },
    {
      "url": "https://github.com/openredact/openredact"
    }
  ],
  "modified_at": "2026-04-18T00:00:00Z"
}
