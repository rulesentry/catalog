{
  "$schema": "https://schemas.rulesentry.io/v5/catalog/rule.schema.json",
  "id": "digital_identity.telegram_bot_token",
  "qualified_id": "rulesentry.digital_identity.telegram_bot_token",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "4.0.0",
  "name": "Telegram Bot Token",
  "description": "Detects Telegram Bot API tokens. Format: [0-9]{8,10}:[A-Za-z0-9_-]{35}. Can control Telegram bots, send messages.\n\nFormat: [botID]:[token]\nRisk: Bot hijacking, spam, phishing",
  "category_id": "digital_identity",
  "severity": "high",
  "profiles": [
    "technology-sector",
    "production"
  ],
  "evaluation": {
    "evaluation_type": "pattern_match",
    "priority": 80,
    "target": "content",
    "pattern": {
      "pattern": "\\b[0-9]{8,10}:[A-Za-z0-9_-]{35}\\b",
      "engine": "regex"
    },
    "effect": {
      "type": "transform",
      "rationale": "compliance",
      "transform": {
        "type": "redact",
        "params": {
          "marker": "[TELEGRAM_BOT_TOKEN]"
        }
      },
      "message": "Telegram Bot Token redacted - redacted"
    }
  },
  "status": "active",
  "created_at": "2026-01-27T00:00:00Z",
  "regions": [
    "GLOBAL"
  ],
  "references": [
    {
      "note": "Based on OpenRedaction community patterns"
    },
    {
      "url": "https://github.com/openredact/openredact"
    }
  ],
  "modified_at": "2026-03-21T00:00:00Z"
}
