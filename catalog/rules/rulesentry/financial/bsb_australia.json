{
  "$schema": "https://schemas.rulesentry.io/v5/catalog/rule.schema.json",
  "id": "financial.bsb_australia",
  "qualified_id": "rulesentry.financial.bsb_australia",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "4.0.0",
  "name": "BSB Number (Australia)",
  "description": "Detects Australian Bank State Branch (BSB) numbers. Format: XXX-XXX (6 digits).\n\nFormat: XXX-XXX (6 digits)",
  "category_id": "financial",
  "severity": "medium",
  "profiles": [
    "financial-industry",
    "production"
  ],
  "evaluation": {
    "evaluation_type": "pattern_match",
    "priority": 70,
    "target": "content",
    "pattern": {
      "pattern": "\\b(?:bsb)[:\\s]+\\d{3}[-\\s]?\\d{3}\\b",
      "engine": "regex",
      "flags": {
        "case_insensitive": true
      }
    },
    "effect": {
      "type": "transform",
      "rationale": "verification",
      "transform": {
        "type": "tokenize",
        "params": {
          "prefix": "BSB",
          "reversible": false
        }
      },
      "message": "BSB number tokenized for de-identification"
    }
  },
  "status": "active",
  "created_at": "2026-01-27T00:00:00Z",
  "regions": [
    "AU"
  ],
  "references": [
    {
      "note": "Based on OpenRedaction community patterns"
    },
    {
      "url": "https://github.com/openredact/openredact"
    }
  ],
  "modified_at": "2026-03-21T00:00:00Z"
}
