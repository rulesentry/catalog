{
  "$schema": "https://schemas.rulesentry.io/v5/catalog/rule.schema.json",
  "id": "financial.clabe_mexico",
  "qualified_id": "rulesentry.financial.clabe_mexico",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "4.0.0",
  "name": "CLABE Number (Mexico)",
  "description": "Detects Mexican CLABE (Clave Bancaria Estandarizada) numbers used for electronic transfers. Format: 18 digits with checksum.\n\nFormat: 18 digits (3 bank + 3 branch + 11 account + 1 checksum)\nValidator: Weighted checksum (3,7,1 cycle) with MOD-10",
  "category_id": "financial",
  "severity": "high",
  "profiles": [
    "financial-industry",
    "production"
  ],
  "evaluation": {
    "evaluation_type": "pattern_match",
    "priority": 75,
    "target": "content",
    "pattern": {
      "pattern": "\\b\\d{18}\\b",
      "engine": "regex",
      "validator": "clabe_checksum"
    },
    "effect": {
      "type": "transform",
      "rationale": "verification",
      "transform": {
        "type": "tokenize",
        "params": {
          "prefix": "CLABE",
          "reversible": false
        }
      },
      "message": "CLABE number tokenized (checksum validated) for de-identification"
    }
  },
  "status": "active",
  "created_at": "2026-01-27T00:00:00Z",
  "regions": [
    "MX"
  ],
  "references": [
    {
      "note": "Based on OpenRedaction community patterns"
    },
    {
      "url": "https://github.com/openredact/openredact"
    }
  ],
  "modified_at": "2026-03-21T00:00:00Z"
}
