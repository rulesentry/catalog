{
  "$schema": "https://schemas.rulesentry.io/v5/catalog/rule.schema.json",
  "id": "financial.credit_debit_card_ner",
  "qualified_id": "rulesentry.financial.credit_debit_card_ner",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "1.0.0",
  "status": "inactive",
  "name": "Credit/Debit Card Number",
  "description": "Detects credit and debit card numbers using an on-device NER model. Complements the regex-based financial.credit_card rule. Rule silently no-ops when no model is active.",
  "category_id": "financial",
  "severity": "medium",
  "regions": [
    "GLOBAL"
  ],
  "profiles": [
    "pci-dss"
  ],
  "tags": [
    "pii",
    "financial",
    "credit-card",
    "ner"
  ],
  "evaluation": {
    "evaluation_type": "ner_match",
    "entity_types": [
      "credit_debit_card"
    ],
    "confidence_threshold": 0.85,
    "model": {
      "fallback": "skip"
    },
    "effect": {
      "type": "transform",
      "rationale": "compliance",
      "transform": {
        "type": "replace",
        "params": {
          "replacement": "[CREDIT_DEBIT_CARD]"
        }
      },
      "message": "Credit/Debit Card Number detected by NER replaced for de-identification"
    }
  },
  "origin": {
    "source_type": "catalog",
    "catalog_url": "https://catalog.rulesentry.io/rules/rulesentry/financial/credit_debit_card_ner"
  },
