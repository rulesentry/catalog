{
  "$schema": "https://schemas.rulesentry.io/v5/catalog/rule.schema.json",
  "id": "financial.cvv_cvc",
  "qualified_id": "rulesentry.financial.cvv_cvc",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "4.0.0",
  "name": "CVV/CVC Security Code",
  "description": "Detects credit card CVV/CVC security codes (3-4 digits). PCI-DSS prohibits storage of CVV codes after authorization.\n\nPCI DSS note: CVV/CVC storage prohibited per PCI-DSS requirement 3.2",
  "category_id": "financial",
  "severity": "critical",
  "profiles": [
    "financial-industry",
    "pci-dss",
    "production"
  ],
  "evaluation": {
    "evaluation_type": "pattern_match",
    "priority": 95,
    "target": "content",
    "pattern": {
      "pattern": "\\b(?:cvv|cvc|cid|csc|cvn|security\\s+code)[:\\s]*\\d{3,4}\\b",
      "engine": "regex",
      "flags": {
        "case_insensitive": true
      }
    },
    "effect": {
      "type": "transform",
      "rationale": "compliance",
      "transform": {
        "type": "redact",
        "params": {
          "marker": "[CVV_CVC]"
        }
      },
      "message": "CVV/CVC redacted - storage prohibited by PCI-DSS 3.2"
    }
  },
  "status": "active",
  "created_at": "2026-01-27T00:00:00Z",
  "regions": [
    "GLOBAL"
  ],
  "references": [
    {
      "note": "Based on OpenRedaction community patterns"
    },
    {
      "url": "https://github.com/openredact/openredact"
    }
  ],
  "modified_at": "2026-03-21T00:00:00Z"
}
