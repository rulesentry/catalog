{
  "$schema": "https://schemas.rulesentry.io/v5/catalog/rule.schema.json",
  "id": "financial.cvv_ner",
  "qualified_id": "rulesentry.financial.cvv_ner",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "1.0.0",
  "status": "inactive",
  "name": "Card Verification Value (CVV)",
  "description": "Detects card CVV/CVC security codes using an on-device NER model. PCI-DSS prohibits storage of CVV data after authorization. Rule silently no-ops when no model is active.",
  "category_id": "financial",
  "severity": "medium",
  "regions": [
    "GLOBAL"
  ],
  "profiles": [
    "pci-dss"
  ],
  "tags": [
    "pii",
    "financial",
    "credit-card",
    "pci",
    "ner"
  ],
  "evaluation": {
    "evaluation_type": "ner_match",
    "entity_types": [
      "cvv"
    ],
    "confidence_threshold": 0.85,
    "model": {
      "fallback": "skip"
    },
    "effect": {
      "type": "transform",
      "rationale": "compliance",
      "transform": {
        "type": "replace",
        "params": {
          "replacement": "[CVV]"
        }
      },
      "message": "Card Verification Value (CVV) detected by NER replaced for de-identification"
    }
  },
  "origin": {
    "source_type": "catalog",
    "catalog_url": "https://catalog.rulesentry.io/rules/rulesentry/financial/cvv_ner"
  },
