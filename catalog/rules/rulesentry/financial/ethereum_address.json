{
  "$schema": "https://schemas.rulesentry.io/v5/catalog/rule.schema.json",
  "id": "financial.ethereum_address",
  "qualified_id": "rulesentry.financial.ethereum_address",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "4.0.0",
  "name": "Ethereum Address",
  "description": "Detects Ethereum cryptocurrency addresses with EIP-55 checksum validation. Ethereum addresses are 40-character hexadecimal strings (42 with 0x prefix) used for wallets and smart contracts.\n\nValidator: EIP-55 mixed-case checksum (basic validation)\nFormat: 0x + 40 hexadecimal characters",
  "category_id": "financial",
  "severity": "high",
  "profiles": [
    "financial-industry",
    "production"
  ],
  "evaluation": {
    "evaluation_type": "pattern_match",
    "priority": 85,
    "target": "content",
    "pattern": {
      "pattern": "\\b0x[a-fA-F0-9]{40}\\b",
      "engine": "regex",
      "validator": "ethereum_checksum"
    },
    "effect": {
      "type": "transform",
      "rationale": "verification",
      "transform": {
        "type": "tokenize",
        "params": {
          "prefix": "ETH",
          "reversible": false
        }
      },
      "message": "Ethereum address tokenized (EIP-55 validated), 0x prefix and suffix visible for de-identification"
    }
  },
  "status": "active",
  "created_at": "2026-01-27T00:00:00Z",
  "regions": [
    "GLOBAL"
  ],
  "references": [
    {
      "note": "Based on OpenRedaction community patterns"
    },
    {
      "url": "https://github.com/openredact/openredact"
    },
    {
      "note": "EIP-55"
    }
  ],
  "modified_at": "2026-03-21T00:00:00Z"
}
