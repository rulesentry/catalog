{
  "$schema": "https://schemas.rulesentry.io/v5/catalog/rule.schema.json",
  "id": "financial.iban_mod97",
  "qualified_id": "rulesentry.financial.iban_mod97",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "4.0.0",
  "name": "IBAN (MOD-97 Validated)",
  "description": "Detects International Bank Account Numbers with MOD-97 checksum validation. Supports all IBAN countries worldwide.\n\nValidator: IBAN MOD-97 (ISO 13616)\nSupported countries: All 36 IBAN countries",
  "category_id": "financial",
  "severity": "high",
  "profiles": [
    "financial-industry",
    "gdpr",
    "production"
  ],
  "evaluation": {
    "evaluation_type": "pattern_match",
    "priority": 90,
    "target": "content",
    "pattern": {
      "pattern": "\\b[A-Z]{2}\\d{2}(?:[ -]?[A-Z0-9]{4}){2,8}(?:[ -]?[A-Z0-9]{1,4})?\\b",
      "engine": "regex",
      "validator": "iban_mod97",
      "validator_params": {
        "strip_chars": " -"
      }
    },
    "effect": {
      "type": "transform",
      "rationale": "verification",
      "transform": {
        "type": "tokenize",
        "params": {
          "prefix": "IBAN"
        }
      },
      "message": "IBAN tokenized (MOD-97 validated)"
    }
  },
  "status": "active",
  "created_at": "2026-01-27T00:00:00Z",
  "regions": [
    "GLOBAL"
  ],
  "references": [
    {
      "note": "Based on OpenRedaction community patterns"
    },
    {
      "url": "https://github.com/openredact/openredact"
    }
  ],
  "modified_at": "2026-03-21T00:00:00Z"
}
