{
  "$schema": "https://schemas.rulesentry.io/v5/catalog/rule.schema.json",
  "id": "financial.isin",
  "qualified_id": "rulesentry.financial.isin",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "4.0.0",
  "name": "ISIN (International Securities Identifier)",
  "description": "Detects International Securities Identification Numbers with Luhn checksum validation. ISIN is a 12-character code that uniquely identifies securities (stocks, bonds, derivatives) globally.\n\nValidator: ISIN MOD-10 (ISO 6166)\nFormat: 2-letter country code + 9 alphanumeric + 1 check digit",
  "category_id": "financial",
  "severity": "medium",
  "profiles": [
    "financial-industry",
    "production"
  ],
  "evaluation": {
    "evaluation_type": "pattern_match",
    "priority": 80,
    "target": "content",
    "pattern": {
      "pattern": "\\b[A-Z]{2}[A-Z0-9]{9}\\d\\b",
      "engine": "regex",
      "validator": "isin_mod10"
    },
    "effect": {
      "type": "transform",
      "rationale": "verification",
      "transform": {
        "type": "tokenize",
        "params": {
          "prefix": "ISIN",
          "reversible": false
        }
      },
      "message": "ISIN tokenized (ISO 6166 MOD-10 validated), country code and check digit visible for de-identification"
    }
  },
  "status": "active",
  "created_at": "2026-01-27T00:00:00Z",
  "regions": [
    "GLOBAL"
  ],
  "references": [
    {
      "note": "Based on OpenRedaction community patterns"
    },
    {
      "url": "https://github.com/openredact/openredact"
    },
    {
      "note": "ISO 6166"
    }
  ],
  "modified_at": "2026-03-21T00:00:00Z"
}
