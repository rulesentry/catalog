{
  "$schema": "https://schemas.rulesentry.io/v5/catalog/rule.schema.json",
  "id": "financial.pin_code",
  "qualified_id": "rulesentry.financial.pin_code",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "4.0.0",
  "name": "PIN Code",
  "description": "Detects references to PIN codes (4-6 digits). PCI-DSS prohibits storage of PINs.\n\nPCI DSS note: PIN storage prohibited per PCI-DSS requirement 3.2",
  "category_id": "financial",
  "severity": "critical",
  "profiles": [
    "financial-industry",
    "pci-dss",
    "production"
  ],
  "evaluation": {
    "evaluation_type": "pattern_match",
    "priority": 93,
    "target": "content",
    "pattern": {
      "pattern": "\\b(?:pin|personal\\s+identification\\s+number)[:\\s]+\\d{4,6}\\b",
      "engine": "regex",
      "flags": {
        "case_insensitive": true
      }
    },
    "effect": {
      "type": "transform",
      "rationale": "compliance",
      "transform": {
        "type": "redact",
        "params": {
          "marker": "[PIN_CODE]"
        }
      },
      "message": "PIN code redacted - storage prohibited by PCI-DSS 3.2"
    }
  },
  "status": "active",
  "created_at": "2026-01-27T00:00:00Z",
  "regions": [
    "GLOBAL"
  ],
  "references": [
    {
      "note": "Based on OpenRedaction community patterns"
    },
    {
      "url": "https://github.com/openredact/openredact"
    }
  ],
  "modified_at": "2026-03-21T00:00:00Z"
}
