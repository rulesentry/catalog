{
  "$schema": "https://schemas.rulesentry.io/v5/catalog/rule.schema.json",
  "id": "financial.routing_number",
  "qualified_id": "rulesentry.financial.routing_number",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "4.0.0",
  "name": "US Routing Number (Checksum Validated)",
  "description": "Detects US bank routing numbers (ABA routing transit numbers) with checksum validation to reduce false positives.\n\nValidator: ABA routing number checksum",
  "category_id": "financial",
  "severity": "high",
  "profiles": [
    "financial-industry",
    "glba",
    "production"
  ],
  "evaluation": {
    "evaluation_type": "pattern_match",
    "priority": 100,
    "target": "content",
    "pattern": {
      "pattern": "\\b\\d{9}\\b",
      "engine": "regex",
      "validator": "routing_checksum"
    },
    "effect": {
      "type": "transform",
      "rationale": "verification",
      "transform": {
        "type": "tokenize",
        "params": {
          "prefix": "RTN",
          "reversible": false
        }
      },
      "message": "Bank routing number tokenized (checksum validated) for de-identification"
    }
  },
  "status": "active",
  "created_at": "2026-01-27T00:00:00Z",
  "regions": [
    "US"
  ],
  "references": [
    {
      "note": "Based on OpenRedaction community patterns"
    },
    {
      "url": "https://github.com/openredact/openredact"
    }
  ],
  "modified_at": "2026-03-21T00:00:00Z"
}
