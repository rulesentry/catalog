{
  "$schema": "https://schemas.rulesentry.io/v5/catalog/rule.schema.json",
  "id": "financial.sedol",
  "qualified_id": "rulesentry.financial.sedol",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "4.0.0",
  "name": "SEDOL (UK/Irish Securities Identifier)",
  "description": "Detects SEDOL numbers with checksum validation. SEDOL uniquely identifies securities traded on the London Stock Exchange and Irish Stock Exchange.\n\nValidator: SEDOL checksum algorithm\nFormat: 6 alphanumeric characters + 1 check digit",
  "category_id": "financial",
  "severity": "medium",
  "profiles": [
    "financial-industry",
    "production",
    "fca",
    "gdpr"
  ],
  "evaluation": {
    "evaluation_type": "pattern_match",
    "priority": 75,
    "target": "content",
    "pattern": {
      "pattern": "\\b[A-Z0-9]{6}\\d\\b",
      "engine": "regex",
      "validator": "sedol_checksum"
    },
    "effect": {
      "type": "transform",
      "rationale": "verification",
      "transform": {
        "type": "tokenize",
        "params": {
          "prefix": "SEDOL",
          "reversible": false
        }
      },
      "message": "SEDOL tokenized (checksum validated), check digit visible for de-identification"
    }
  },
  "status": "active",
  "created_at": "2026-01-27T00:00:00Z",
  "regions": [
    "UK",
    "IE"
  ],
  "references": [
    {
      "note": "Based on OpenRedaction community patterns"
    },
    {
      "url": "https://github.com/openredact/openredact"
    },
    {
      "note": "London Stock Exchange"
    }
  ],
  "modified_at": "2026-03-21T00:00:00Z"
}
