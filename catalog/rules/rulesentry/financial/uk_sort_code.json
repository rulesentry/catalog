{
  "$schema": "https://schemas.rulesentry.io/v5/catalog/rule.schema.json",
  "id": "financial.uk_sort_code",
  "qualified_id": "rulesentry.financial.uk_sort_code",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "4.0.0",
  "name": "UK Sort Code (Format Validated)",
  "description": "Detects UK bank sort codes with format validation. Sort codes identify UK bank branches.\n\nValidator: UK sort code format (formatted variants only: DD-DD-DD or DD DD DD)",
  "category_id": "financial",
  "severity": "high",
  "profiles": [
    "financial-industry",
    "gdpr",
    "production"
  ],
  "evaluation": {
    "evaluation_type": "pattern_match",
    "priority": 80,
    "target": "content",
    "pattern": {
      "pattern": "\\b(?:\\d{2}-\\d{2}-\\d{2}|\\d{2}\\s\\d{2}\\s\\d{2})\\b",
      "engine": "regex",
      "validator": "sort_code_format"
    },
    "effect": {
      "type": "transform",
      "rationale": "verification",
      "transform": {
        "type": "tokenize",
        "params": {
          "prefix": "SORT",
          "reversible": false
        }
      },
      "message": "UK sort code tokenized (format validated) for de-identification"
    }
  },
  "status": "active",
  "created_at": "2026-01-27T00:00:00Z",
  "regions": [
    "UK"
  ],
  "references": [
    {
      "note": "Based on OpenRedaction community patterns"
    },
    {
      "url": "https://github.com/openredact/openredact"
    }
  ],
  "modified_at": "2026-03-21T00:00:00Z"
}
