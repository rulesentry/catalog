{
  "$schema": "https://schemas.rulesentry.io/v5/catalog/rule.schema.json",
  "id": "government.africa_egypt_national_id",
  "qualified_id": "rulesentry.government.africa_egypt_national_id",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "4.0.0",
  "name": "Egyptian National ID Number",
  "description": "Detects Egyptian national identity card numbers. Encodes century, birth date, governorate, and sequence.\n\nFormat: 14 digits (C YY MM DD GG SSSS S where C=century, YY=year, MM=month, DD=day, GG=governorate, SSSS=sequence, S=gender)\nOfficial name: الرقم القومي (National ID)\nNote: Data Protection Law No. 151 of 2020",
  "category_id": "government",
  "severity": "high",
  "profiles": [
    "government-sector",
    "production"
  ],
  "evaluation": {
    "evaluation_type": "pattern_match",
    "priority": 85,
    "target": "content",
    "pattern": {
      "pattern": "\\b[23][0-9]{2}(0[1-9]|1[0-2])(0[1-9]|[12][0-9]|3[01])[0-9]{2}[0-9]{5}\\b",
      "engine": "regex"
    },
    "effect": {
      "type": "transform",
      "rationale": "compliance",
      "transform": {
        "type": "tokenize",
        "params": {
          "prefix": "EG_ID",
          "reversible": false
        }
      },
      "message": "Egypt national ID tokenized for de-identification"
    }
  },
  "status": "active",
  "created_at": "2026-01-27T00:00:00Z",
  "regions": [
    "EG"
  ],
  "references": [
    {
      "note": "Based on OpenRedaction community patterns"
    },
    {
      "url": "https://github.com/openredact/openredact"
    }
  ],
  "modified_at": "2026-03-21T00:00:00Z"
}
