{
  "$schema": "https://schemas.rulesentry.io/v5/catalog/rule.schema.json",
  "id": "government.africa_ghana_gps",
  "qualified_id": "rulesentry.government.africa_ghana_gps",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "4.0.0",
  "name": "Ghana Card (Ghana Integrated Personal ID)",
  "description": "Detects Ghanaian national identification card numbers.\n\nFormat: 15 characters (GHA-XXXXXXXXX-X)\nOfficial name: Ghana Card\nNote: Data Protection Act, 2012 (Act 843)",
  "category_id": "government",
  "severity": "high",
  "profiles": [
    "government-sector",
    "production"
  ],
  "evaluation": {
    "evaluation_type": "pattern_match",
    "priority": 85,
    "target": "content",
    "pattern": {
      "pattern": "\\bGHA-[0-9]{9}-[0-9]\\b",
      "engine": "regex",
      "flags": {
        "case_insensitive": true
      }
    },
    "effect": {
      "type": "transform",
      "rationale": "compliance",
      "transform": {
        "type": "tokenize",
        "params": {
          "prefix": "GH_ID",
          "reversible": false
        }
      },
      "message": "Ghana GPS address tokenized for de-identification"
    }
  },
  "status": "active",
  "created_at": "2026-01-27T00:00:00Z",
  "regions": [
    "GH"
  ],
  "references": [
    {
      "note": "Based on OpenRedaction community patterns"
    },
    {
      "url": "https://github.com/openredact/openredact"
    }
  ],
  "modified_at": "2026-03-21T00:00:00Z"
}
