{
  "$schema": "https://schemas.rulesentry.io/v5/catalog/rule.schema.json",
  "id": "government.africa_nigeria_vehicle_registration",
  "qualified_id": "rulesentry.government.africa_nigeria_vehicle_registration",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "4.0.0",
  "name": "Nigerian Vehicle Registration Plate",
  "description": "Detects Nigerian vehicle registration plate numbers. Format: 3-letter LGA code + 3 digits + 2-letter code.\n\nFormat: ABC-123DE (LGA code + serial + year/batch code)",
  "category_id": "government",
  "severity": "low",
  "profiles": [
    "government-sector",
    "production"
  ],
  "evaluation": {
    "evaluation_type": "pattern_match",
    "priority": 50,
    "target": "content",
    "pattern": {
      "pattern": "\\b[A-Z]{3}[- ]?\\d{3}[- ]?[A-Z]{2}\\b",
      "engine": "regex",
      "validator": "context_filter",
      "validator_params": {
        "reject_keywords": [
          "example",
          "sample",
          "test",
          "demo"
        ]
      }
    },
    "effect": {
      "type": "transform",
      "rationale": "compliance",
      "transform": {
        "type": "redact",
        "params": {
          "marker": "[NG_VEHICLE_REG]"
        }
      },
      "message": "Nigerian vehicle registration plate redacted"
    }
  },
  "status": "active",
  "created_at": "2026-03-17T00:00:00Z",
  "regions": [
    "NG"
  ],
  "references": [
    {
      "note": "Based on Presidio NgVehicleRegistrationRecognizer"
    },
    {
      "url": "https://github.com/microsoft/presidio"
    }
  ],
  "modified_at": "2026-03-21T00:00:00Z"
}
