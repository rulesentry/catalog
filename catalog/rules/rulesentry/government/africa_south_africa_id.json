{
  "$schema": "https://schemas.rulesentry.io/v5/catalog/rule.schema.json",
  "id": "government.africa_south_africa_id",
  "qualified_id": "rulesentry.government.africa_south_africa_id",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "4.0.0",
  "name": "South African ID Number",
  "description": "Detects South African identity numbers with Luhn checksum validation. Encodes birth date, gender, and citizenship.\n\nValidator: Luhn checksum (last digit)\nFormat: 13 digits (YYMMDD SSSS C A Z where YYMMDD=birth date, SSSS=gender, C=citizenship, A=always 8, Z=checksum)\nOfficial name: South African ID Number\nNote: POPIA (Protection of Personal Information Act) requires protection",
  "category_id": "government",
  "severity": "high",
  "profiles": [
    "government-sector",
    "production"
  ],
  "evaluation": {
    "evaluation_type": "pattern_match",
    "priority": 85,
    "target": "content",
    "pattern": {
      "pattern": "\\b[0-9]{2}(0[1-9]|1[0-2])(0[1-9]|[12][0-9]|3[01])[0-9]{4}[01]8[0-9]\\b",
      "engine": "regex",
      "validator": "luhn"
    },
    "effect": {
      "type": "transform",
      "rationale": "compliance",
      "transform": {
        "type": "tokenize",
        "params": {
          "prefix": "ZA_ID",
          "reversible": false
        }
      },
      "message": "South Africa ID tokenized for de-identification"
    }
  },
  "status": "active",
  "created_at": "2026-01-27T00:00:00Z",
  "regions": [
    "ZA"
  ],
  "references": [
    {
      "note": "Based on OpenRedaction community patterns"
    },
    {
      "url": "https://github.com/openredact/openredact"
    }
  ],
  "modified_at": "2026-03-21T00:00:00Z"
}
