{
  "$schema": "https://schemas.rulesentry.io/v5/catalog/rule.schema.json",
  "id": "government.americas_argentina_dni",
  "qualified_id": "rulesentry.government.americas_argentina_dni",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "4.0.0",
  "name": "Argentine DNI (Documento Nacional de Identidad)",
  "description": "Detects Argentine national identity document numbers.\n\nFormat: 7-8 digits (formatted with dots: XX.XXX.XXX)\nOfficial name: Documento Nacional de Identidad\nNote: Law 25,326 Personal Data Protection",
  "category_id": "government",
  "severity": "high",
  "profiles": [
    "government-sector",
    "production"
  ],
  "evaluation": {
    "evaluation_type": "pattern_match",
    "priority": 80,
    "target": "content",
    "pattern": {
      "pattern": "\\b[0-9]{1,2}[.]?[0-9]{3}[.]?[0-9]{3}\\b",
      "engine": "regex"
    },
    "effect": {
      "type": "transform",
      "rationale": "compliance",
      "transform": {
        "type": "tokenize",
        "params": {
          "prefix": "AR_DNI",
          "reversible": false
        }
      },
      "message": "Argentina DNI tokenized for de-identification"
    }
  },
  "status": "active",
  "created_at": "2026-01-27T00:00:00Z",
  "regions": [
    "AR"
  ],
  "references": [
    {
      "note": "Based on OpenRedaction community patterns"
    },
    {
      "url": "https://github.com/openredact/openredact"
    }
  ],
  "modified_at": "2026-03-21T00:00:00Z"
}
