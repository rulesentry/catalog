{
  "$schema": "https://schemas.rulesentry.io/v5/catalog/rule.schema.json",
  "id": "government.americas_brazil_cpf",
  "qualified_id": "rulesentry.government.americas_brazil_cpf",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "4.0.0",
  "name": "Brazilian CPF (Cadastro de Pessoas Físicas)",
  "description": "Detects Brazilian individual taxpayer registry numbers with check digit validation.\n\nValidator: Two check digits calculated via weighted modulo-11\nFormat: 11 digits (formatted as XXX.XXX.XXX-XX)\nOfficial name: Cadastro de Pessoas Físicas\nNote: LGPD (Lei Geral de Proteção de Dados) requires protection",
  "category_id": "government",
  "severity": "high",
  "profiles": [
    "government-sector",
    "lgpd",
    "production"
  ],
  "evaluation": {
    "evaluation_type": "pattern_match",
    "priority": 85,
    "target": "content",
    "pattern": {
      "pattern": "\\b[0-9]{3}[.]?[0-9]{3}[.]?[0-9]{3}[-]?[0-9]{2}\\b",
      "engine": "regex",
      "validator": "cpf_checksum"
    },
    "effect": {
      "type": "transform",
      "rationale": "compliance",
      "transform": {
        "type": "tokenize",
        "params": {
          "prefix": "BR_CPF",
          "reversible": false
        }
      },
      "message": "Brazil CPF tokenized for de-identification"
    }
  },
  "status": "active",
  "created_at": "2026-01-27T00:00:00Z",
  "regions": [
    "BR"
  ],
  "references": [
    {
      "note": "Based on OpenRedaction community patterns"
    },
    {
      "url": "https://github.com/openredact/openredact"
    }
  ],
  "modified_at": "2026-03-21T00:00:00Z"
}
