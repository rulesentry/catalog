{
  "$schema": "https://schemas.rulesentry.io/v5/catalog/rule.schema.json",
  "id": "government.americas_chile_rut",
  "qualified_id": "rulesentry.government.americas_chile_rut",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "4.0.0",
  "name": "Chilean RUT (Rol Único Tributario)",
  "description": "Detects Chilean unique tax role numbers with check digit (Modulo 11) validation.\n\nValidator: Modulo 11 check digit (can be 0-9 or K)\nFormat: 7-8 digits + check digit (formatted: XX.XXX.XXX-X)\nOfficial name: Rol Único Tributario\nNote: Law 19,628 Protection of Privacy",
  "category_id": "government",
  "severity": "high",
  "profiles": [
    "government-sector",
    "production"
  ],
  "evaluation": {
    "evaluation_type": "pattern_match",
    "priority": 85,
    "target": "content",
    "pattern": {
      "pattern": "\\b[0-9]{1,2}[.]?[0-9]{3}[.]?[0-9]{3}[-]?[0-9K]\\b",
      "engine": "regex",
      "validator": "rut_mod11",
      "flags": {
        "case_insensitive": true
      }
    },
    "effect": {
      "type": "transform",
      "rationale": "compliance",
      "transform": {
        "type": "tokenize",
        "params": {
          "prefix": "CL_RUT",
          "reversible": false
        }
      },
      "message": "Chile RUT tokenized for de-identification"
    }
  },
  "status": "active",
  "created_at": "2026-01-27T00:00:00Z",
  "regions": [
    "CL"
  ],
  "references": [
    {
      "note": "Based on OpenRedaction community patterns"
    },
    {
      "url": "https://github.com/openredact/openredact"
    }
  ],
  "modified_at": "2026-03-21T00:00:00Z"
}
