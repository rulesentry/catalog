{
  "$schema": "https://schemas.rulesentry.io/v5/catalog/rule.schema.json",
  "id": "government.americas_mexico_curp",
  "qualified_id": "rulesentry.government.americas_mexico_curp",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "4.0.0",
  "name": "Mexican CURP (Clave Única de Registro de Población)",
  "description": "Detects Mexican unique population registry codes with check digit validation. Encodes name, birth date, gender, and birthplace.\n\nValidator: Check digit calculated from alphanumeric encoding\nFormat: 18 characters (4 letters + 6 digits + 1 letter + 5 alphanumeric + 1 digit)\nOfficial name: Clave Única de Registro de Población\nNote: Encodes surname, name, birth date, gender, state",
  "category_id": "government",
  "severity": "high",
  "profiles": [
    "government-sector",
    "production"
  ],
  "evaluation": {
    "evaluation_type": "pattern_match",
    "priority": 85,
    "target": "content",
    "pattern": {
      "pattern": "\\b[A-Z]{4}[0-9]{6}[HM][A-Z]{2}[A-Z0-9]{3}[A-Z0-9][0-9]\\b",
      "engine": "regex",
      "validator": "curp_checksum"
    },
    "effect": {
      "type": "transform",
      "rationale": "compliance",
      "transform": {
        "type": "tokenize",
        "params": {
          "prefix": "MX_CURP",
          "reversible": false
        }
      },
      "message": "Mexico CURP tokenized for de-identification"
    }
  },
  "status": "active",
  "created_at": "2026-01-27T00:00:00Z",
  "regions": [
    "MX"
  ],
  "references": [
    {
      "note": "Based on OpenRedaction community patterns"
    },
    {
      "url": "https://github.com/openredact/openredact"
    }
  ],
  "modified_at": "2026-03-21T00:00:00Z"
}
