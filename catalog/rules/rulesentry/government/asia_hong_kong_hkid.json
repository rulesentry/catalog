{
  "$schema": "https://schemas.rulesentry.io/v5/catalog/rule.schema.json",
  "id": "government.asia_hong_kong_hkid",
  "qualified_id": "rulesentry.government.asia_hong_kong_hkid",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "4.0.0",
  "name": "Hong Kong ID Card Number (HKID)",
  "description": "Detects Hong Kong Identity Card numbers with check digit validation.\n\nValidator: Weighted modulo-11 check digit\nFormat: 1-2 letters + 6 digits + check digit (parentheses) (e.g., A123456(7))\nOfficial name: 香港身份證 (HKID Card)",
  "category_id": "government",
  "severity": "high",
  "profiles": [
    "government-sector",
    "production"
  ],
  "evaluation": {
    "evaluation_type": "pattern_match",
    "priority": 85,
    "target": "content",
    "pattern": {
      "pattern": "\\b[A-Z]{1,2}[0-9]{6}\\([0-9A]\\)\\b",
      "engine": "regex",
      "validator": "hkid_checksum"
    },
    "effect": {
      "type": "transform",
      "rationale": "compliance",
      "transform": {
        "type": "tokenize",
        "params": {
          "prefix": "HK_ID",
          "reversible": false
        }
      },
      "message": "Hong Kong HKID tokenized for de-identification"
    }
  },
  "status": "active",
  "created_at": "2026-01-27T00:00:00Z",
  "regions": [
    "HK"
  ],
  "references": [
    {
      "note": "Based on OpenRedaction community patterns"
    },
    {
      "url": "https://github.com/openredact/openredact"
    }
  ],
  "modified_at": "2026-03-21T00:00:00Z"
}
