{
  "$schema": "https://schemas.rulesentry.io/v5/catalog/rule.schema.json",
  "id": "government.asia_japanese_my_number",
  "qualified_id": "rulesentry.government.asia_japanese_my_number",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "4.0.0",
  "name": "Japanese My Number (Individual Number)",
  "description": "Detects Japanese My Number identification with check digit validation. Used for social security, taxation, and disaster response.\n\nValidator: Check digit calculated using Luhn-like MOD-11\nFormat: 12 digits (e.g., 123456789012)\nOfficial name: マイナンバー (My Number)\nNote: Act on the Use of Numbers requires strict protection",
  "category_id": "government",
  "severity": "critical",
  "profiles": [
    "government-sector",
    "production"
  ],
  "evaluation": {
    "evaluation_type": "pattern_match",
    "priority": 90,
    "target": "content",
    "pattern": {
      "pattern": "\\b[0-9]{12}\\b",
      "engine": "regex",
      "validator": "my_number_checksum"
    },
    "effect": {
      "type": "transform",
      "rationale": "compliance",
      "transform": {
        "type": "redact",
        "params": {
          "marker": "[JP_MY_NUMBER]"
        }
      },
      "message": "Japanese My Number redacted per Act on Use of Numbers"
    }
  },
  "status": "active",
  "created_at": "2026-01-27T00:00:00Z",
  "regions": [
    "JP"
  ],
  "references": [
    {
      "note": "Based on OpenRedaction community patterns"
    },
    {
      "url": "https://github.com/openredact/openredact"
    }
  ],
  "modified_at": "2026-03-21T00:00:00Z"
}
