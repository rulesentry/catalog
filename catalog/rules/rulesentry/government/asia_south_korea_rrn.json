{
  "$schema": "https://schemas.rulesentry.io/v5/catalog/rule.schema.json",
  "id": "government.asia_south_korea_rrn",
  "qualified_id": "rulesentry.government.asia_south_korea_rrn",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "4.0.0",
  "name": "South Korean Resident Registration Number (RRN)",
  "description": "Detects Korean RRN (Jumin Deungnok Beonho) with checksum validation. Format encodes birth date and gender.\n\nValidator: Weighted sum modulo checksum\nFormat: 6 digits (YYMMDD) + 7 digits (gender/serial/checksum)\nOfficial name: 주민등록번호 (Jumin Deungnok Beonho)\nNote: PIPA (Personal Information Protection Act) requires strict handling",
  "category_id": "government",
  "severity": "critical",
  "profiles": [
    "government-sector",
    "production"
  ],
  "evaluation": {
    "evaluation_type": "pattern_match",
    "priority": 90,
    "target": "content",
    "pattern": {
      "pattern": "\\b[0-9]{6}-[1-4][0-9]{6}\\b",
      "engine": "regex",
      "validator": "rrn_checksum"
    },
    "effect": {
      "type": "transform",
      "rationale": "compliance",
      "transform": {
        "type": "redact",
        "params": {
          "marker": "[KR_RRN]"
        }
      },
      "message": "Korean RRN redacted per PIPA (Personal Information Protection Act)"
    }
  },
  "status": "active",
  "created_at": "2026-01-27T00:00:00Z",
  "regions": [
    "KR"
  ],
  "references": [
    {
      "note": "Based on OpenRedaction community patterns"
    },
    {
      "url": "https://github.com/openredact/openredact"
    }
  ],
  "modified_at": "2026-03-21T00:00:00Z"
}
