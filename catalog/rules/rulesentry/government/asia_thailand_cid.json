{
  "$schema": "https://schemas.rulesentry.io/v5/catalog/rule.schema.json",
  "id": "government.asia_thailand_cid",
  "qualified_id": "rulesentry.government.asia_thailand_cid",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "4.0.0",
  "name": "Thailand Citizen ID Number",
  "description": "Detects Thai national identification card numbers with MOD-11 checksum validation.\n\nValidator: MOD-11 checksum (last digit)\nFormat: 13 digits (often written with spaces: 1 2345 67890 12 3)\nOfficial name: เลขประจำตัวประชาชน (Citizen ID)",
  "category_id": "government",
  "severity": "high",
  "profiles": [
    "government-sector",
    "production"
  ],
  "evaluation": {
    "evaluation_type": "pattern_match",
    "priority": 85,
    "target": "content",
    "pattern": {
      "pattern": "\\b[0-9]\\s?[0-9]{4}\\s?[0-9]{5}\\s?[0-9]{2}\\s?[0-9]\\b",
      "engine": "regex",
      "validator": "thailand_cid_mod11"
    },
    "effect": {
      "type": "transform",
      "rationale": "compliance",
      "transform": {
        "type": "tokenize",
        "params": {
          "prefix": "TH_CID",
          "reversible": false
        }
      },
      "message": "Thailand CID tokenized for de-identification"
    }
  },
  "status": "active",
  "created_at": "2026-01-27T00:00:00Z",
  "regions": [
    "TH"
  ],
  "references": [
    {
      "note": "Based on OpenRedaction community patterns"
    },
    {
      "url": "https://github.com/openredact/openredact"
    }
  ],
  "modified_at": "2026-03-21T00:00:00Z"
}
