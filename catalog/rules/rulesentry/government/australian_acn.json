{
  "$schema": "https://schemas.rulesentry.io/v5/catalog/rule.schema.json",
  "id": "government.australian_acn",
  "qualified_id": "rulesentry.government.australian_acn",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "4.0.0",
  "name": "Australian Company Number (ACN)",
  "description": "Detects Australian Company Numbers with MOD-10 complement checksum validation. Format: 9 digits (XXX XXX XXX) preceded by context keywords.\n\nFormat: 9 digits (XXX XXX XXX)\nValidator: Weighted sum MOD-10 with complement check digit",
  "category_id": "government",
  "severity": "medium",
  "profiles": [
    "government-sector",
    "production"
  ],
  "evaluation": {
    "evaluation_type": "pattern_match",
    "priority": 70,
    "target": "content",
    "pattern": {
      "pattern": "\\b(?:ACN|Australian\\s+Company\\s+Number)[:\\s]+\\d{3}\\s?\\d{3}\\s?\\d{3}\\b",
      "engine": "regex",
      "validator": "acn_mod10",
      "flags": {
        "case_insensitive": true
      }
    },
    "effect": {
      "type": "transform",
      "rationale": "compliance",
      "transform": {
        "type": "tokenize",
        "params": {
          "prefix": "ACN_AU",
          "reversible": false
        }
      },
      "message": "Australian Company Number tokenized for de-identification"
    }
  },
  "status": "active",
  "created_at": "2026-03-17T00:00:00Z",
  "regions": [
    "AU"
  ],
  "references": [
    {
      "note": "ASIC Australian Company Number format"
    },
    {
      "note": "Australian Securities and Investments Commission (ASIC)"
    }
  ],
  "modified_at": "2026-03-21T00:00:00Z"
}
