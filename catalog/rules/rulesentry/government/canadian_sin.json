{
  "$schema": "https://schemas.rulesentry.io/v5/catalog/rule.schema.json",
  "id": "government.canadian_sin",
  "qualified_id": "rulesentry.government.canadian_sin",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "4.0.0",
  "name": "Canadian Social Insurance Number (SIN)",
  "description": "Detects Canadian Social Insurance Numbers with MOD-10 checksum validation. Format: XXX-XXX-XXX (9 digits).\n\nFormat: XXX-XXX-XXX (9 digits)\nRationale: Two alternatives: (1) with SIN keyword label — separator optional; (2) without label — separator required ([-\\s] not [-\\s]?). Bare 9-digit strings like ABA routing numbers (e.g. 021000021) pass Luhn by coincidence; requiring a dash/space separator when unlabeled eliminates that collision.",
  "category_id": "government",
  "severity": "critical",
  "profiles": [
    "government-sector",
    "pipeda",
    "production"
  ],
  "evaluation": {
    "evaluation_type": "pattern_match",
    "priority": 100,
    "target": "content",
    "pattern": {
      "pattern": "(?:(?:sin|s\\.i\\.n\\.|social\\s+insurance(?:\\s+number)?)[:\\s#-]*\\d{3}[-\\s]?\\d{3}[-\\s]?\\d{3}|\\b\\d{3}[-\\s]\\d{3}[-\\s]\\d{3})\\b",
      "engine": "regex",
      "validator": "canadian_sin_mod10"
    },
    "effect": {
      "type": "transform",
      "rationale": "verification",
      "transform": {
        "type": "tokenize",
        "params": {
          "prefix": "SIN",
          "reversible": false
        }
      },
      "message": "Canadian SIN tokenized for de-identification"
    }
  },
  "status": "active",
  "created_at": "2026-01-27T00:00:00Z",
  "regions": [
    "CA"
  ],
  "references": [
    {
      "note": "Based on OpenRedaction community patterns"
    },
    {
      "url": "https://github.com/openredact/openredact"
    }
  ],
  "modified_at": "2026-04-15T00:00:00Z"
}
