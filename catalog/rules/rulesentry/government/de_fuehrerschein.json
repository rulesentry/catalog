{
  "$schema": "https://schemas.rulesentry.io/v5/catalog/rule.schema.json",
  "id": "government.de_fuehrerschein",
  "qualified_id": "rulesentry.government.de_fuehrerschein",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "4.0.0",
  "status": "active",
  "name": "German Driving License Number (Führerscheinnummer)",
  "description": "Detects German driving license numbers in the EU harmonized format. Format: 2 letters (issuing authority) + 8 digits + 1 alphanumeric check character. No published normative check-digit algorithm.\n\nFormat: XX12345678Y — 2 letters + 8 digits + 1 alphanumeric\nOfficial name: Führerscheinnummer",
  "category_id": "government",
  "severity": "medium",
  "profiles": [
    "government-sector",
    "gdpr",
    "production"
  ],
  "regions": [
    "DE"
  ],
  "tags": [
    "pii",
    "government-id",
    "driving-license",
    "gdpr"
  ],
  "evaluation": {
    "evaluation_type": "pattern_match",
    "priority": 65,
    "target": "content",
    "pattern": {
      "pattern": "\\b[A-Z]{2}\\d{8}[A-Z0-9]\\b",
      "engine": "regex"
    },
    "effect": {
      "type": "transform",
      "rationale": "compliance",
      "transform": {
        "type": "tokenize",
        "params": {
          "prefix": "DE_FUEHRERSCHEIN",
          "reversible": false
        }
      },
      "message": "German driving license number tokenized for de-identification"
    }
  },
  "created_at": "2026-05-27T00:00:00Z",
  "references": [
    {
      "note": "Based on Presidio DeFuehrerscheinRecognizer"
    },
    {
      "url": "https://github.com/microsoft/presidio"
    }
  ],
  "modified_at": "2026-05-27T00:00:00Z"
}
