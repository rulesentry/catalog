{
  "$schema": "https://schemas.rulesentry.io/v4/catalog/rule.schema.json",
  "id": "government.de_handelsregister",
  "qualified_id": "rulesentry.government.de_handelsregister",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "4.0.0",
  "status": "active",
  "name": "German Commercial Register Number (Handelsregisternummer)",
  "description": "Detects German commercial register numbers. Format: HRA or HRB followed by 1-6 digits. HRA for sole traders and partnerships; HRB for limited liability companies (GmbH, AG). Optionally followed by court identifier.",
  "category_id": "government",
  "severity": "medium",
  "profiles": [
    "government-sector",
    "gdpr",
    "production"
  ],
  "regions": [
    "DE"
  ],
  "tags": [
    "pii",
    "government-id",
    "business-id",
    "gdpr"
  ],
  "metadata": {
    "country": "Germany",
    "pattern_source": "Based on Presidio DeHandelsregisterRecognizer",
    "attribution": "https://github.com/microsoft/presidio",
    "format": "HRA 12345 or HRB 123456 — HRA/HRB prefix + 1-6 digits",
    "official_name": "Handelsregisternummer",
    "needs_review": false
  },
  "evaluation": {
    "evaluation_type": "pattern_match",
    "priority": 70,
    "target": "content",
    "pattern": {
      "pattern": "\\bHR[AB]\\s*\\d{1,6}\\b",
      "engine": "regex",
      "flags": {
        "case_insensitive": false
      }
    },
    "effect": {
      "type": "transform",
      "rationale": "compliance",
      "transform": {
        "type": "tokenize",
        "params": {
          "prefix": "DE_HRB",
          "reversible": false
        }
      },
      "message": "German commercial register number tokenized for de-identification"
    }
  },
  "created_at": "2026-05-27T00:00:00Z",
  "updated_at": "2026-05-27T00:00:00Z"
}
