{
  "$schema": "https://schemas.rulesentry.io/v4/catalog/rule.schema.json",
  "id": "government.de_kfz",
  "qualified_id": "rulesentry.government.de_kfz",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "4.0.0",
  "status": "active",
  "name": "German Vehicle Registration Plate (Kraftfahrzeugkennzeichen)",
  "description": "Detects German vehicle registration plates. Format: 1-3 letter district code + 1-2 letter recognition digits + 1-4 digits with optional E (electric) or H (historic) suffix. Unicode flag required for umlaut characters in district codes.",
  "category_id": "government",
  "severity": "low",
  "profiles": [
    "government-sector",
    "gdpr",
    "production"
  ],
  "regions": [
    "DE"
  ],
  "tags": [
    "pii",
    "vehicle",
    "gdpr"
  ],
  "metadata": {
    "country": "Germany",
    "pattern_source": "Based on Presidio DeKfzRecognizer",
    "attribution": "https://github.com/microsoft/presidio",
    "format": "AB CD 1234 — 1-3 letter district + space + 1-2 letters + space + 1-4 digits + optional E/H",
    "official_name": "Kraftfahrzeugkennzeichen (KFZ-Kennzeichen)",
    "needs_review": false
  },
  "evaluation": {
    "evaluation_type": "pattern_match",
    "priority": 55,
    "target": "content",
    "pattern": {
      "pattern": "(?<![\\w])[A-ZÄÖÜ]{1,3}\\s[A-Z]{1,2}\\s\\d{1,4}[EH]?(?![\\w])",
      "engine": "regex",
      "flags": {
        "unicode": true
      }
    },
    "effect": {
      "type": "transform",
      "rationale": "compliance",
      "transform": {
        "type": "tokenize",
        "params": {
          "prefix": "DE_KFZ",
          "reversible": false
        }
      },
      "message": "German vehicle plate tokenized for de-identification"
    }
  },
  "created_at": "2026-05-27T00:00:00Z",
  "updated_at": "2026-05-27T00:00:00Z"
}
