{
  "$schema": "https://schemas.rulesentry.io/v5/catalog/rule.schema.json",
  "id": "government.de_steuernummer",
  "qualified_id": "rulesentry.government.de_steuernummer",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "4.0.0",
  "status": "active",
  "name": "German State Tax Number (Steuernummer)",
  "description": "Detects German state-specific tax numbers (Steuernummer). Distinct from the federal Steueridentifikationsnummer (EU DE_TAX_ID). Format varies by state: 10-13 digits; the first 2-4 digits encode the issuing Finanzamt. No universal published check-digit algorithm.\n\nFormat: 10-13 digits; state-prefixed (e.g., 18181508155 for Bayern)\nOfficial name: Steuernummer\nNote: Distinct from Steuer-ID (Steueridentifikationsnummer); context required to reduce false positives from generic digit runs",
  "category_id": "government",
  "severity": "high",
  "profiles": [
    "government-sector",
    "gdpr",
    "production"
  ],
  "regions": [
    "DE"
  ],
  "tags": [
    "pii",
    "government-id",
    "tax",
    "gdpr"
  ],
  "evaluation": {
    "evaluation_type": "pattern_match",
    "priority": 70,
    "target": "content",
    "pattern": {
      "pattern": "(?:steuernummer|steuernr\\.?|st\\.?-nr\\.?)[:\\s]*([0-9]{10,13})\\b",
      "engine": "regex",
      "flags": {
        "case_insensitive": true
      }
    },
    "effect": {
      "type": "transform",
      "rationale": "compliance",
      "transform": {
        "type": "tokenize",
        "params": {
          "prefix": "DE_STEUERNUMMER",
          "reversible": false
        }
      },
      "message": "German Steuernummer tokenized for de-identification"
    }
  },
  "created_at": "2026-05-27T00:00:00Z",
  "references": [
    {
      "note": "Based on Presidio DeSteuernummerRecognizer"
    },
    {
      "url": "https://github.com/microsoft/presidio"
    }
  ],
  "modified_at": "2026-05-27T00:00:00Z"
}
