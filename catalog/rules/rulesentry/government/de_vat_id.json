{
  "$schema": "https://schemas.rulesentry.io/v4/catalog/rule.schema.json",
  "id": "government.de_vat_id",
  "qualified_id": "rulesentry.government.de_vat_id",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "4.0.0",
  "status": "active",
  "name": "German VAT ID (Umsatzsteuer-Identifikationsnummer)",
  "description": "Detects German VAT identification numbers. Format: DE prefix followed by 9 digits. Validates using ISO 7064 Mod 11,10 iterative algorithm (community heuristic — BZSt does not publish a normative check-digit specification).",
  "category_id": "government",
  "severity": "medium",
  "profiles": [
    "government-sector",
    "gdpr",
    "production"
  ],
  "regions": [
    "DE"
  ],
  "tags": [
    "pii",
    "government-id",
    "tax",
    "vat",
    "gdpr"
  ],
  "metadata": {
    "country": "Germany",
    "pattern_source": "Based on Presidio DeVatRecognizer",
    "attribution": "https://github.com/microsoft/presidio",
    "format": "DE123456789 — DE prefix + 9 digits",
    "official_name": "Umsatzsteuer-Identifikationsnummer (USt-IdNr.)",
    "note": "Checksum is a community heuristic; structural match is authoritative",
    "needs_review": false
  },
  "evaluation": {
    "evaluation_type": "pattern_match",
    "priority": 75,
    "target": "content",
    "pattern": {
      "pattern": "\\bDE\\d{9}\\b",
      "engine": "regex",
      "validator": "de_vat_id_mod11"
    },
    "effect": {
      "type": "transform",
      "rationale": "compliance",
      "transform": {
        "type": "tokenize",
        "params": {
          "prefix": "DE_VAT_ID",
          "reversible": false
        }
      },
      "message": "German VAT ID tokenized for de-identification"
    }
  },
  "created_at": "2026-05-27T00:00:00Z",
  "updated_at": "2026-05-27T00:00:00Z"
}
