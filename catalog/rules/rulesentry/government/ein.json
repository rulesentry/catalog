{
  "$schema": "https://schemas.rulesentry.io/v5/catalog/rule.schema.json",
  "id": "government.ein",
  "qualified_id": "rulesentry.government.ein",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "4.0.0",
  "name": "US Employer Identification Number (EIN)",
  "description": "Detects US Employer Identification Numbers (Tax ID). Format: XX-XXXXXXX (9 digits).\n\nFormat: XX-XXXXXXX (9 digits)",
  "category_id": "government",
  "severity": "high",
  "profiles": [
    "government-sector",
    "glba",
    "production"
  ],
  "evaluation": {
    "evaluation_type": "pattern_match",
    "priority": 75,
    "target": "content",
    "pattern": {
      "pattern": "\\b(?:EIN|Tax ID|Employer ID|TIN)[:\\s]+\\d{2}[-\\s]?\\d{7}\\b",
      "engine": "regex",
      "validator": "ein_prefix_validation",
      "flags": {
        "case_insensitive": true
      }
    },
    "effect": {
      "type": "transform",
      "rationale": "verification",
      "transform": {
        "type": "tokenize",
        "params": {
          "prefix": "EIN",
          "reversible": false
        }
      },
      "message": "EIN tokenized for de-identification"
    }
  },
  "status": "active",
  "created_at": "2026-01-27T00:00:00Z",
  "regions": [
    "US"
  ],
  "references": [
    {
      "note": "Based on OpenRedaction community patterns"
    },
    {
      "url": "https://github.com/openredact/openredact"
    }
  ],
  "modified_at": "2026-03-21T00:00:00Z"
}
