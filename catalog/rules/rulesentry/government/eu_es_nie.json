{
  "$schema": "https://schemas.rulesentry.io/v5/catalog/rule.schema.json",
  "id": "government.eu_es_nie",
  "qualified_id": "rulesentry.government.eu_es_nie",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "4.0.0",
  "name": "Spanish NIE (Foreigner Identity Number)",
  "description": "Detects Spanish Número de Identidad de Extranjero. Format: X/Y/Z prefix + 7 digits + check letter. Uses MOD-23 lookup table (same as DNI) after letter-to-digit substitution.\n\nValidator: MOD-23 with X→0, Y→1, Z→2 prefix substitution and letter lookup table TRWAGMYFPDXBNJZSQVHLCKE\nFormat: X1234567A (X/Y/Z + 7 digits + check letter)\nOfficial name: Número de Identidad de Extranjero (NIE)\nNote: Checksum validation deferred to future hardcoded validator; pattern structure provides moderate precision",
  "category_id": "government",
  "severity": "high",
  "profiles": [
    "government-sector",
    "gdpr",
    "production"
  ],
  "evaluation": {
    "evaluation_type": "pattern_match",
    "priority": 80,
    "target": "content",
    "pattern": {
      "pattern": "\\b[XYZ]\\d{7}[A-Z]\\b",
      "engine": "regex",
      "validator": "context_filter",
      "validator_params": {
        "reject_keywords": [
          "example",
          "sample",
          "test",
          "demo"
        ]
      }
    },
    "effect": {
      "type": "transform",
      "rationale": "compliance",
      "transform": {
        "type": "tokenize",
        "params": {
          "prefix": "ES_NIE",
          "reversible": false
        }
      },
      "message": "Spanish NIE tokenized for de-identification"
    }
  },
  "status": "active",
  "created_at": "2026-03-17T00:00:00Z",
  "regions": [
    "ES"
  ],
  "references": [
    {
      "note": "Based on Presidio EsNieRecognizer"
    },
    {
      "url": "https://github.com/microsoft/presidio"
    }
  ],
  "modified_at": "2026-03-21T00:00:00Z"
}
