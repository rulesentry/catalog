{
  "$schema": "https://schemas.rulesentry.io/v5/catalog/rule.schema.json",
  "id": "government.eu_french_carte_nationale",
  "qualified_id": "rulesentry.government.eu_french_carte_nationale",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "4.0.0",
  "name": "French National ID (Carte Nationale d'Identité)",
  "description": "Detects French national identity card numbers. Format: 12 alphanumeric characters.\n\nFormat: 12 alphanumeric characters\nOfficial name: Carte Nationale d'Identité",
  "category_id": "government",
  "severity": "high",
  "profiles": [
    "government-sector",
    "gdpr",
    "production"
  ],
  "evaluation": {
    "evaluation_type": "pattern_match",
    "priority": 80,
    "target": "content",
    "pattern": {
      "pattern": "\\b[0-9]{12}\\b",
      "engine": "regex"
    },
    "effect": {
      "type": "transform",
      "rationale": "compliance",
      "transform": {
        "type": "tokenize",
        "params": {
          "prefix": "CNI"
        }
      },
      "message": "French national ID tokenized per GDPR"
    }
  },
  "status": "active",
  "created_at": "2026-01-27T00:00:00Z",
  "regions": [
    "FR"
  ],
  "references": [
    {
      "note": "Based on OpenRedaction community patterns"
    },
    {
      "url": "https://github.com/openredact/openredact"
    }
  ],
  "modified_at": "2026-03-21T00:00:00Z"
}
