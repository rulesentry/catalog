{
  "$schema": "https://schemas.rulesentry.io/v5/catalog/rule.schema.json",
  "id": "government.eu_it_passport",
  "qualified_id": "rulesentry.government.eu_it_passport",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "4.0.0",
  "name": "Italian Passport Number",
  "description": "Detects Italian passport numbers. Format: 2 letters followed by 7 digits. Context-anchored to reduce false positives from this short pattern.\n\nFormat: AA1234567 (2 letters + 7 digits)\nOfficial name: Passaporto\nNote: Weak pattern; context prefix required to reduce false positives",
  "category_id": "government",
  "severity": "medium",
  "profiles": [
    "government-sector",
    "gdpr",
    "production"
  ],
  "evaluation": {
    "evaluation_type": "pattern_match",
    "priority": 60,
    "target": "content",
    "pattern": {
      "pattern": "(?:passaporto|passport|documento\\s+di\\s+viaggio)[\\s:# -]*([A-Z]{2}\\d{7})\\b",
      "engine": "regex",
      "flags": {
        "case_insensitive": true
      }
    },
    "effect": {
      "type": "transform",
      "rationale": "compliance",
      "transform": {
        "type": "tokenize",
        "params": {
          "prefix": "IT_PASSPORT",
          "reversible": false
        }
      },
      "message": "Italian passport number tokenized for de-identification"
    }
  },
  "status": "active",
  "created_at": "2026-03-17T00:00:00Z",
  "regions": [
    "IT"
  ],
  "references": [
    {
      "note": "Based on Presidio ItPassportRecognizer"
    },
    {
      "url": "https://github.com/microsoft/presidio"
    }
  ],
  "modified_at": "2026-03-21T00:00:00Z"
}
