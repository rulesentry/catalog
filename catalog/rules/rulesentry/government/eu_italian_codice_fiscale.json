{
  "$schema": "https://schemas.rulesentry.io/v5/catalog/rule.schema.json",
  "id": "government.eu_italian_codice_fiscale",
  "qualified_id": "rulesentry.government.eu_italian_codice_fiscale",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "4.0.0",
  "name": "Italian Tax Code (Codice Fiscale)",
  "description": "Detects Italian tax identification codes with checksum validation. Format: 16 alphanumeric characters (surname, name, birth date, birthplace).\n\nValidator: Codice Fiscale checksum (last character)\nFormat: 6 letters + 2 digits + 1 letter + 2 digits + 4 alphanumeric + 1 check letter\nOfficial name: Codice Fiscale\nNote: Encodes surname, name, birth date, and birthplace",
  "category_id": "government",
  "severity": "high",
  "profiles": [
    "government-sector",
    "gdpr",
    "production"
  ],
  "evaluation": {
    "evaluation_type": "pattern_match",
    "priority": 85,
    "target": "content",
    "pattern": {
      "pattern": "\\b[A-Z]{6}[0-9LMNPQRSTUV]{2}[ABCDEHLMPRST][0-9LMNPQRSTUV]{2}[A-Z][0-9LMNPQRSTUV]{3}[A-Z]\\b",
      "engine": "regex",
      "validator": "codice_fiscale_checksum"
    },
    "effect": {
      "type": "transform",
      "rationale": "compliance",
      "transform": {
        "type": "tokenize",
        "params": {
          "prefix": "IT_CF",
          "reversible": false
        }
      },
      "message": "Italian Codice Fiscale tokenized for de-identification"
    }
  },
  "status": "active",
  "created_at": "2026-01-27T00:00:00Z",
  "regions": [
    "IT"
  ],
  "references": [
    {
      "note": "Based on OpenRedaction community patterns"
    },
    {
      "url": "https://github.com/openredact/openredact"
    }
  ],
  "modified_at": "2026-03-21T00:00:00Z"
}
