{
  "$schema": "https://schemas.rulesentry.io/v5/catalog/rule.schema.json",
  "id": "government.eu_netherlands_bsn",
  "qualified_id": "rulesentry.government.eu_netherlands_bsn",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "4.0.0",
  "name": "Dutch Citizen Service Number (BSN)",
  "description": "Detects Dutch BSN (Burgerservicenummer) with 11-test checksum validation.\n\nValidator: 11-test (elfproef) checksum\nFormat: 9 consecutive digits (e.g. 123456789)\nOfficial name: Burgerservicenummer",
  "category_id": "government",
  "severity": "high",
  "profiles": [
    "government-sector",
    "gdpr",
    "production"
  ],
  "evaluation": {
    "evaluation_type": "pattern_match",
    "priority": 85,
    "target": "content",
    "pattern": {
      "pattern": "\\b[0-9]{9}\\b",
      "engine": "regex",
      "validator": "bsn_11test"
    },
    "effect": {
      "type": "transform",
      "rationale": "compliance",
      "transform": {
        "type": "tokenize",
        "params": {
          "prefix": "NL_BSN",
          "reversible": false
        }
      },
      "message": "Netherlands BSN tokenized for de-identification"
    }
  },
  "status": "active",
  "created_at": "2026-01-27T00:00:00Z",
  "regions": [
    "NL"
  ],
  "references": [
    {
      "note": "Based on OpenRedaction community patterns"
    },
    {
      "url": "https://github.com/openredact/openredact"
    }
  ],
  "modified_at": "2026-03-21T00:00:00Z"
}
