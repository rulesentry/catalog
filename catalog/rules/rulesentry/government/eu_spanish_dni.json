{
  "$schema": "https://schemas.rulesentry.io/v5/catalog/rule.schema.json",
  "id": "government.eu_spanish_dni",
  "qualified_id": "rulesentry.government.eu_spanish_dni",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "4.0.0",
  "name": "Spanish National ID (DNI)",
  "description": "Detects Spanish DNI (Documento Nacional de Identidad) with MOD-23 checksum validation.\n\nValidator: MOD-23 checksum (letter calculated from number)\nFormat: 8 digits + 1 letter (e.g., 12345678Z)\nOfficial name: Documento Nacional de Identidad",
  "category_id": "government",
  "severity": "high",
  "profiles": [
    "government-sector",
    "gdpr",
    "production"
  ],
  "evaluation": {
    "evaluation_type": "pattern_match",
    "priority": 85,
    "target": "content",
    "pattern": {
      "pattern": "\\b[0-9]{8}[A-Z]\\b",
      "engine": "regex",
      "validator": "dni_mod23"
    },
    "effect": {
      "type": "transform",
      "rationale": "compliance",
      "transform": {
        "type": "tokenize",
        "params": {
          "prefix": "ES_DNI",
          "reversible": false
        }
      },
      "message": "Spanish DNI tokenized for de-identification"
    }
  },
  "status": "active",
  "created_at": "2026-01-27T00:00:00Z",
  "regions": [
    "ES"
  ],
  "references": [
    {
      "note": "Based on OpenRedaction community patterns"
    },
    {
      "url": "https://github.com/openredact/openredact"
    }
  ],
  "modified_at": "2026-03-21T00:00:00Z"
}
