{
  "$schema": "https://schemas.rulesentry.io/v5/catalog/rule.schema.json",
  "id": "government.german_tax_id",
  "qualified_id": "rulesentry.government.german_tax_id",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "4.0.0",
  "name": "German Tax ID (Steueridentifikationsnummer)",
  "description": "Detects German tax identification numbers. Format: 11 digits.\n\nFormat: XXXXXXXXXXX (11 digits)",
  "category_id": "government",
  "severity": "high",
  "profiles": [
    "government-sector",
    "gdpr",
    "production"
  ],
  "evaluation": {
    "evaluation_type": "pattern_match",
    "priority": 85,
    "target": "content",
    "pattern": {
      "pattern": "\\b(?:steuer|tax|steuernummer|tax\\s+id)[:\\s]+\\d{11}\\b",
      "engine": "regex",
      "flags": {
        "case_insensitive": true
      }
    },
    "effect": {
      "type": "transform",
      "rationale": "compliance",
      "transform": {
        "type": "tokenize",
        "params": {
          "prefix": "DE_TAX",
          "reversible": false
        }
      },
      "message": "German tax ID tokenized for de-identification"
    }
  },
  "status": "active",
  "created_at": "2026-01-27T00:00:00Z",
  "regions": [
    "DE"
  ],
  "references": [
    {
      "note": "Based on OpenRedaction community patterns"
    },
    {
      "url": "https://github.com/openredact/openredact"
    }
  ],
  "modified_at": "2026-03-21T00:00:00Z"
}
