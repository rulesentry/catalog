{
  "$schema": "https://schemas.rulesentry.io/v5/catalog/rule.schema.json",
  "id": "government.indian_aadhaar",
  "qualified_id": "rulesentry.government.indian_aadhaar",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "4.0.0",
  "name": "Indian Aadhaar Number",
  "description": "Detects Indian Aadhaar unique identification numbers with Verhoeff checksum validation. Format: XXXX-XXXX-XXXX (12 digits).\n\nFormat: XXXX-XXXX-XXXX (12 digits)",
  "category_id": "government",
  "severity": "critical",
  "profiles": [
    "government-sector",
    "production"
  ],
  "evaluation": {
    "evaluation_type": "pattern_match",
    "priority": 100,
    "target": "content",
    "pattern": {
      "pattern": "\\b\\d{4}[-\\s]?\\d{4}[-\\s]?\\d{4}\\b",
      "engine": "regex",
      "validator": "indian_aadhaar_verhoeff"
    },
    "effect": {
      "type": "transform",
      "rationale": "verification",
      "transform": {
        "type": "tokenize",
        "params": {
          "prefix": "AADHAAR",
          "reversible": false
        }
      },
      "message": "Indian Aadhaar number tokenized for de-identification"
    }
  },
  "status": "active",
  "created_at": "2026-01-27T00:00:00Z",
  "regions": [
    "IN"
  ],
  "references": [
    {
      "note": "Based on OpenRedaction community patterns"
    },
    {
      "url": "https://github.com/openredact/openredact"
    }
  ],
  "modified_at": "2026-03-21T00:00:00Z"
}
