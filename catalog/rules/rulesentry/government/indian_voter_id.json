{
  "$schema": "https://schemas.rulesentry.io/v5/catalog/rule.schema.json",
  "id": "government.indian_voter_id",
  "qualified_id": "rulesentry.government.indian_voter_id",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "4.0.0",
  "name": "Indian Voter ID (EPIC)",
  "description": "Detects Indian Elector's Photo Identity Card (EPIC) numbers. Format: 3 letters followed by 7 digits. Context-anchored to reduce false positives.\n\nFormat: ABC1234567 (3 letters + 7 digits)\nOfficial name: Elector's Photo Identity Card (EPIC)\nNote: Weak pattern; context prefix required to reduce false positives",
  "category_id": "government",
  "severity": "medium",
  "profiles": [
    "government-sector",
    "production"
  ],
  "evaluation": {
    "evaluation_type": "pattern_match",
    "priority": 60,
    "target": "content",
    "pattern": {
      "pattern": "(?:voter\\s+(?:id|card)|EPIC|elector(?:'s)?\\s+(?:photo\\s+)?identity\\s+card|voter\\s+(?:no|number|num|#))[\\s:# -]*([A-Z]{3}\\d{7})\\b",
      "engine": "regex",
      "flags": {
        "case_insensitive": true
      }
    },
    "effect": {
      "type": "transform",
      "rationale": "compliance",
      "transform": {
        "type": "tokenize",
        "params": {
          "prefix": "IN_VOTER",
          "reversible": false
        }
      },
      "message": "Indian voter ID (EPIC) tokenized for de-identification"
    }
  },
  "status": "active",
  "created_at": "2026-03-17T00:00:00Z",
  "regions": [
    "IN"
  ],
  "references": [
    {
      "note": "Based on Presidio InVoterRecognizer"
    },
    {
      "url": "https://github.com/microsoft/presidio"
    }
  ],
  "modified_at": "2026-03-21T00:00:00Z"
}
