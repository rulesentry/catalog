{
  "$schema": "https://schemas.rulesentry.io/v5/catalog/rule.schema.json",
  "id": "government.japan_my_number",
  "qualified_id": "rulesentry.government.japan_my_number",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "4.0.0",
  "name": "Japan My Number",
  "description": "Detects Japanese Social Security and Tax Numbers (My Number). Format: XXXX-XXXX-XXXX (12 digits). Note: MOD-11 checksum validator to be implemented.\n\nFormat: XXXX-XXXX-XXXX (12 digits)\nNote: MOD-11 checksum validator not yet implemented",
  "category_id": "government",
  "severity": "critical",
  "profiles": [
    "government-sector",
    "production"
  ],
  "evaluation": {
    "evaluation_type": "pattern_match",
    "priority": 100,
    "target": "content",
    "pattern": {
      "pattern": "\\b(?:my\\s+number|マイナンバー)[:\\s]+\\d{4}[-\\s]?\\d{4}[-\\s]?\\d{4}\\b",
      "engine": "regex",
      "flags": {
        "case_insensitive": true
      }
    },
    "effect": {
      "type": "transform",
      "rationale": "compliance",
      "transform": {
        "type": "tokenize",
        "params": {
          "prefix": "MY_NUMBER",
          "reversible": false
        }
      },
      "message": "Japan My Number tokenized for de-identification"
    }
  },
  "status": "active",
  "created_at": "2026-01-27T00:00:00Z",
  "regions": [
    "JP"
  ],
  "references": [
    {
      "note": "Based on OpenRedaction community patterns"
    },
    {
      "url": "https://github.com/openredact/openredact"
    }
  ],
  "modified_at": "2026-03-21T00:00:00Z"
}
