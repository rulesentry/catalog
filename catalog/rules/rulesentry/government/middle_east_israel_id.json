{
  "$schema": "https://schemas.rulesentry.io/v5/catalog/rule.schema.json",
  "id": "government.middle_east_israel_id",
  "qualified_id": "rulesentry.government.middle_east_israel_id",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "4.0.0",
  "name": "Israeli ID Number (Teudat Zehut)",
  "description": "Detects Israeli identity card numbers with Luhn checksum validation.\n\nValidator: Luhn checksum (last digit)\nFormat: 9 digits (padded with leading zeros if needed)\nOfficial name: תעודת זהות (Teudat Zehut)\nNote: Privacy Protection Law, 1981",
  "category_id": "government",
  "severity": "high",
  "profiles": [
    "government-sector",
    "production"
  ],
  "evaluation": {
    "evaluation_type": "pattern_match",
    "priority": 85,
    "target": "content",
    "pattern": {
      "pattern": "\\b[0-9]{9}\\b",
      "engine": "regex",
      "validator": "luhn"
    },
    "effect": {
      "type": "transform",
      "rationale": "compliance",
      "transform": {
        "type": "tokenize",
        "params": {
          "prefix": "IL_ID",
          "reversible": false
        }
      },
      "message": "Israel ID tokenized for de-identification"
    }
  },
  "status": "active",
  "created_at": "2026-01-27T00:00:00Z",
  "regions": [
    "IL"
  ],
  "references": [
    {
      "note": "Based on OpenRedaction community patterns"
    },
    {
      "url": "https://github.com/openredact/openredact"
    }
  ],
  "modified_at": "2026-03-21T00:00:00Z"
}
