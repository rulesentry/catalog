{
  "$schema": "https://schemas.rulesentry.io/v5/catalog/rule.schema.json",
  "id": "government.middle_east_turkey_tc_kimlik",
  "qualified_id": "rulesentry.government.middle_east_turkey_tc_kimlik",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "4.0.0",
  "name": "Turkish TC Kimlik No (Turkish ID)",
  "description": "Detects Turkish Republic citizenship ID numbers with custom checksum validation.\n\nValidator: Custom Turkish ID checksum (10th and 11th digits)\nFormat: 11 digits (cannot start with 0)\nOfficial name: TC Kimlik Numarası\nNote: KVKK (Personal Data Protection Law No. 6698)",
  "category_id": "government",
  "severity": "high",
  "profiles": [
    "government-sector",
    "production"
  ],
  "evaluation": {
    "evaluation_type": "pattern_match",
    "priority": 85,
    "target": "content",
    "pattern": {
      "pattern": "\\b[1-9][0-9]{10}\\b",
      "engine": "regex",
      "validator": "tc_kimlik_checksum"
    },
    "effect": {
      "type": "transform",
      "rationale": "compliance",
      "transform": {
        "type": "tokenize",
        "params": {
          "prefix": "TR_TC",
          "reversible": false
        }
      },
      "message": "Turkey TC Kimlik tokenized for de-identification"
    }
  },
  "status": "active",
  "created_at": "2026-01-27T00:00:00Z",
  "regions": [
    "TR"
  ],
  "references": [
    {
      "note": "Based on OpenRedaction community patterns"
    },
    {
      "url": "https://github.com/openredact/openredact"
    }
  ],
  "modified_at": "2026-03-21T00:00:00Z"
}
