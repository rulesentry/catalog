{
  "$schema": "https://schemas.rulesentry.io/v5/catalog/rule.schema.json",
  "id": "government.middle_east_uae_emirates_id",
  "qualified_id": "rulesentry.government.middle_east_uae_emirates_id",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "4.0.0",
  "name": "UAE Emirates ID",
  "description": "Detects United Arab Emirates national identity card numbers.\n\nFormat: 15 digits (784-YYYY-NNNNNNN-N where 784 is UAE country code)\nOfficial name: Emirates ID / بطاقة الهوية\nNote: Federal Decree-Law on Personal Data Protection",
  "category_id": "government",
  "severity": "high",
  "profiles": [
    "government-sector",
    "production"
  ],
  "evaluation": {
    "evaluation_type": "pattern_match",
    "priority": 85,
    "target": "content",
    "pattern": {
      "pattern": "\\b784[-]?[0-9]{4}[-]?[0-9]{7}[-]?[0-9]\\b",
      "engine": "regex"
    },
    "effect": {
      "type": "transform",
      "rationale": "compliance",
      "transform": {
        "type": "tokenize",
        "params": {
          "prefix": "AE_EID",
          "reversible": false
        }
      },
      "message": "UAE Emirates ID tokenized for de-identification"
    }
  },
  "status": "active",
  "created_at": "2026-01-27T00:00:00Z",
  "regions": [
    "AE"
  ],
  "references": [
    {
      "note": "Based on OpenRedaction community patterns"
    },
    {
      "url": "https://github.com/openredact/openredact"
    }
  ],
  "modified_at": "2026-03-21T00:00:00Z"
}
