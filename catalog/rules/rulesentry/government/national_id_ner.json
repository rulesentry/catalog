  "version": "1.1.0",
  "status": "inactive",
  "name": "National ID",
  "description": "Detects national identification numbers using an on-device NER model. Rule silently no-ops when no model is active.",
  "category_id": "government",
  "severity": "medium",
  "regions": [
    "GLOBAL"
  ],
  "profiles": [
    "gdpr",
    "ccpa",
    "production"
  ],
  "tags": [
