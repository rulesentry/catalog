{
  "$schema": "https://schemas.rulesentry.io/v5/catalog/rule.schema.json",
  "id": "government.nhs_mod11",
  "qualified_id": "rulesentry.government.nhs_mod11",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "4.0.0",
  "name": "UK NHS Number (MOD-11 Validated)",
  "description": "Detects UK National Health Service numbers with MOD-11 checksum validation. NHS numbers uniquely identify patients in the UK healthcare system.\n\nValidator: NHS MOD-11 checksum (NHS Scotland CHI specification)",
  "category_id": "government",
  "severity": "critical",
  "profiles": [
    "government-sector",
    "gdpr",
    "uk-dpa",
    "production"
  ],
  "evaluation": {
    "evaluation_type": "pattern_match",
    "priority": 100,
    "target": "content",
    "pattern": {
      "pattern": "\\b\\d{3}[\\s]?\\d{3}[\\s]?\\d{4}\\b",
      "engine": "regex",
      "validator": "nhs_mod11"
    },
    "effect": {
      "type": "transform",
      "rationale": "compliance",
      "transform": {
        "type": "tokenize",
        "params": {
          "prefix": "NHS",
          "reversible": false
        }
      },
      "message": "NHS number tokenized (MOD-11 validated) for de-identification"
    }
  },
  "status": "active",
  "created_at": "2026-01-27T00:00:00Z",
  "regions": [
    "UK"
  ],
  "references": [
    {
      "note": "Based on OpenRedaction community patterns"
    },
    {
      "url": "https://github.com/openredact/openredact"
    }
  ],
  "modified_at": "2026-03-21T00:00:00Z"
}
