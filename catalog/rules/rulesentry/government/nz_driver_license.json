{
  "$schema": "https://schemas.rulesentry.io/v5/catalog/rule.schema.json",
  "id": "government.nz_driver_license",
  "qualified_id": "rulesentry.government.nz_driver_license",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "4.0.0",
  "name": "New Zealand Driver Licence Number",
  "description": "Detects New Zealand driver licence numbers. Format: 2 letters followed by 6 digits, preceded by context keywords.\n\nFormat: 2 letters + 6 digits (e.g., AB123456)",
  "category_id": "government",
  "severity": "medium",
  "profiles": [
    "government-sector",
    "production"
  ],
  "evaluation": {
    "evaluation_type": "pattern_match",
    "priority": 65,
    "target": "content",
    "pattern": {
      "pattern": "\\b(?:driver'?s?\\s+licen[cs]e|DL|licence\\s+number)[:\\s]+[A-Z]{2}\\d{6}\\b",
      "engine": "regex",
      "flags": {
        "case_insensitive": true
      }
    },
    "effect": {
      "type": "transform",
      "rationale": "compliance",
      "transform": {
        "type": "tokenize",
        "params": {
          "prefix": "DL_NZ",
          "reversible": false
        }
      },
      "message": "New Zealand driver licence number tokenized for de-identification"
    }
  },
  "status": "active",
  "created_at": "2026-03-17T00:00:00Z",
  "regions": [
    "NZ"
  ],
  "references": [
    {
      "note": "NZ Transport Agency driver licence format"
    },
    {
      "note": "Waka Kotahi NZ Transport Agency"
    }
  ],
  "modified_at": "2026-03-21T00:00:00Z"
}
