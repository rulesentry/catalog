{
  "$schema": "https://schemas.rulesentry.io/v5/catalog/rule.schema.json",
  "id": "government.nz_ird",
  "qualified_id": "rulesentry.government.nz_ird",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "4.0.0",
  "name": "New Zealand IRD Number",
  "description": "Detects New Zealand Inland Revenue Department (IRD) numbers. Format: 8 or 9 digits preceded by context keywords. MOD-11 checksum validator may be added in follow-up.\n\nFormat: 8-9 digits with context keywords",
  "category_id": "government",
  "severity": "high",
  "profiles": [
    "government-sector",
    "production"
  ],
  "evaluation": {
    "evaluation_type": "pattern_match",
    "priority": 75,
    "target": "content",
    "pattern": {
      "pattern": "\\b(?:IRD|IRD\\s+number|tax\\s+number)[:\\s]+\\d{8,9}\\b",
      "engine": "regex",
      "flags": {
        "case_insensitive": true
      }
    },
    "effect": {
      "type": "transform",
      "rationale": "compliance",
      "transform": {
        "type": "tokenize",
        "params": {
          "prefix": "IRD_NZ",
          "reversible": false
        }
      },
      "message": "New Zealand IRD number tokenized for de-identification"
    }
  },
  "status": "active",
  "created_at": "2026-03-17T00:00:00Z",
  "regions": [
    "NZ"
  ],
  "references": [
    {
      "note": "NZ Inland Revenue IRD number format"
    },
    {
      "note": "Inland Revenue Department (Te Tari Taake)"
    }
  ],
  "modified_at": "2026-03-21T00:00:00Z"
}
