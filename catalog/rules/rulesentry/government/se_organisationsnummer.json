{
  "$schema": "https://schemas.rulesentry.io/v5/catalog/rule.schema.json",
  "id": "government.se_organisationsnummer",
  "qualified_id": "rulesentry.government.se_organisationsnummer",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "4.0.0",
  "status": "active",
  "name": "Swedish Organization Number (Organisationsnummer)",
  "description": "Detects Swedish organization numbers. Format: NNNNNN-NNNN (10 digits, third digit must be >= 2 to distinguish from personnummer). Luhn checksum on all 10 digits.\n\nFormat: NNNNNN-NNNN — third digit >= 2 distinguishes from personnummer\nOfficial name: Organisationsnummer",
  "category_id": "government",
  "severity": "medium",
  "profiles": [
    "government-sector",
    "gdpr",
    "production"
  ],
  "regions": [
    "SE"
  ],
  "tags": [
    "pii",
    "government-id",
    "business-id",
    "gdpr"
  ],
  "evaluation": {
    "evaluation_type": "pattern_match",
    "priority": 75,
    "target": "content",
    "pattern": {
      "pattern": "\\b\\d{2}[2-9]\\d{3}[-]\\d{4}\\b",
      "engine": "regex",
      "validator": "se_organisationsnummer_luhn"
    },
    "effect": {
      "type": "transform",
      "rationale": "compliance",
      "transform": {
        "type": "tokenize",
        "params": {
          "prefix": "SE_ORG",
          "reversible": false
        }
      },
      "message": "Swedish organisationsnummer tokenized for de-identification"
    }
  },
  "created_at": "2026-05-27T00:00:00Z",
  "references": [
    {
      "note": "Based on Presidio SvOrganisationsnummerRecognizer"
    },
    {
      "url": "https://github.com/microsoft/presidio"
    }
  ],
  "modified_at": "2026-05-27T00:00:00Z"
}
