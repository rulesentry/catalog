{
  "$schema": "https://schemas.rulesentry.io/v4/catalog/rule.schema.json",
  "id": "government.se_organisationsnummer",
  "qualified_id": "rulesentry.government.se_organisationsnummer",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "4.0.0",
  "status": "active",
  "name": "Swedish Organization Number (Organisationsnummer)",
  "description": "Detects Swedish organization numbers. Format: NNNNNN-NNNN (10 digits, third digit must be >= 2 to distinguish from personnummer). Luhn checksum on all 10 digits.",
  "category_id": "government",
  "severity": "medium",
  "profiles": [
    "government-sector",
    "gdpr",
    "production"
  ],
  "regions": [
    "SE"
  ],
  "tags": [
    "pii",
    "government-id",
    "business-id",
    "gdpr"
  ],
  "metadata": {
    "country": "Sweden",
    "pattern_source": "Based on Presidio SvOrganisationsnummerRecognizer",
    "attribution": "https://github.com/microsoft/presidio",
    "format": "NNNNNN-NNNN — third digit >= 2 distinguishes from personnummer",
    "official_name": "Organisationsnummer",
    "needs_review": false
  },
  "evaluation": {
    "evaluation_type": "pattern_match",
    "priority": 75,
    "target": "content",
    "pattern": {
      "pattern": "\\b\\d{2}[2-9]\\d{3}[-]\\d{4}\\b",
      "engine": "regex",
      "validator": "se_organisationsnummer_luhn"
    },
    "effect": {
      "type": "transform",
      "rationale": "compliance",
      "transform": {
        "type": "tokenize",
        "params": {
          "prefix": "SE_ORG",
          "reversible": false
        }
      },
      "message": "Swedish organisationsnummer tokenized for de-identification"
    }
  },
  "created_at": "2026-05-27T00:00:00Z",
  "updated_at": "2026-05-27T00:00:00Z"
}
