{
  "$schema": "https://schemas.rulesentry.io/v5/catalog/rule.schema.json",
  "id": "government.se_personnummer",
  "qualified_id": "rulesentry.government.se_personnummer",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "4.0.0",
  "status": "active",
  "name": "Swedish Personal Identity Number (Personnummer)",
  "description": "Detects Swedish personal identity numbers (personnummer). Format: YYMMDD-NNNNC or YYYYMMDD-NNNNC. Samordningsnummer adds 60 to the day component. Luhn checksum validates the last 10 digits.\n\nFormat: YYMMDD-NNNNC or YYYYMMDD-NNNNC; day 61-91 = samordningsnummer\nOfficial name: Personnummer",
  "category_id": "government",
  "severity": "critical",
  "profiles": [
    "government-sector",
    "gdpr",
    "production"
  ],
  "regions": [
    "SE"
  ],
  "tags": [
    "pii",
    "government-id",
    "national-id",
    "gdpr"
  ],
  "evaluation": {
    "evaluation_type": "pattern_match",
    "priority": 90,
    "target": "content",
    "pattern": {
      "pattern": "\\b(?:\\d{8}|\\d{6})[\\-+]\\d{4}\\b",
      "engine": "regex",
      "validator": "se_personnummer_luhn"
    },
    "effect": {
      "type": "transform",
      "rationale": "compliance",
      "transform": {
        "type": "tokenize",
        "params": {
          "prefix": "SE_PERSONNUMMER",
          "reversible": false
        }
      },
      "message": "Swedish personnummer tokenized for de-identification"
    }
  },
  "created_at": "2026-05-27T00:00:00Z",
  "references": [
    {
      "note": "Based on Presidio SvPersonnummerRecognizer"
    },
    {
      "url": "https://github.com/microsoft/presidio"
    }
  ],
  "modified_at": "2026-05-27T00:00:00Z"
}
