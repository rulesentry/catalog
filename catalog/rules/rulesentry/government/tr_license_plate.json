{
  "$schema": "https://schemas.rulesentry.io/v4/catalog/rule.schema.json",
  "id": "government.tr_license_plate",
  "qualified_id": "rulesentry.government.tr_license_plate",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "4.0.0",
  "status": "active",
  "name": "Turkish Vehicle License Plate",
  "description": "Detects Turkish vehicle license plates. Format: 2-digit province code (01-81) + 1-3 letters + 2-4 digits. Province codes 00 and 82-99 are invalid (Karayolları Trafik Kanunu KTK Madde 23). Validates province range via prefix_check validator.",
  "category_id": "government",
  "severity": "low",
  "profiles": [
    "government-sector",
    "gdpr",
    "production"
  ],
  "regions": [
    "TR"
  ],
  "tags": [
    "pii",
    "vehicle",
    "gdpr"
  ],
  "metadata": {
    "country": "Turkey",
    "pattern_source": "Based on Presidio TrLicensePlateRecognizer",
    "attribution": "https://github.com/microsoft/presidio",
    "format": "01 A 1234 — 2-digit province (01-81) + 1-3 letters + 2-4 digits",
    "official_name": "Motorlu Taşıt Tescil Belgesi Plakası",
    "needs_review": false
  },
  "evaluation": {
    "evaluation_type": "pattern_match",
    "priority": 55,
    "target": "content",
    "pattern": {
      "pattern": "\\b(0[1-9]|[1-7][0-9]|8[01])\\s?[A-PR-VY-Z]{1,3}\\s?\\d{2,4}\\b",
      "engine": "regex",
      "validator": "tr_license_plate_province"
    },
    "effect": {
      "type": "transform",
      "rationale": "compliance",
      "transform": {
        "type": "tokenize",
        "params": {
          "prefix": "TR_PLATE",
          "reversible": false
        }
      },
      "message": "Turkish license plate tokenized for de-identification"
    }
  },
  "created_at": "2026-05-27T00:00:00Z",
  "updated_at": "2026-05-27T00:00:00Z"
}
