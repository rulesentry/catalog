{
  "$schema": "https://schemas.rulesentry.io/v5/catalog/rule.schema.json",
  "id": "government.uk_utr",
  "qualified_id": "rulesentry.government.uk_utr",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "4.0.0",
  "name": "UK Unique Taxpayer Reference (UTR)",
  "description": "Detects UK Unique Taxpayer References issued by HMRC. Format: 10 digits preceded by context keywords (UTR, unique taxpayer reference, tax reference).\n\nFormat: 10 digits with context keywords",
  "category_id": "government",
  "severity": "high",
  "profiles": [
    "government-sector",
    "uk-dpa",
    "production"
  ],
  "evaluation": {
    "evaluation_type": "pattern_match",
    "priority": 75,
    "target": "content",
    "pattern": {
      "pattern": "\\b(?:UTR|unique\\s+taxpayer\\s+reference|tax\\s+reference)[:\\s]+\\d{10}\\b",
      "engine": "regex",
      "flags": {
        "case_insensitive": true
      }
    },
    "effect": {
      "type": "transform",
      "rationale": "compliance",
      "transform": {
        "type": "tokenize",
        "params": {
          "prefix": "UTR_UK",
          "reversible": false
        }
      },
      "message": "UK Unique Taxpayer Reference tokenized for de-identification"
    }
  },
  "status": "active",
  "created_at": "2026-03-17T00:00:00Z",
  "regions": [
    "UK"
  ],
  "references": [
    {
      "note": "HMRC UTR format specification"
    },
    {
      "note": "HM Revenue & Customs"
    }
  ],
  "modified_at": "2026-03-21T00:00:00Z"
}
