{
  "$schema": "https://schemas.rulesentry.io/v5/catalog/rule.schema.json",
  "id": "government.us_immigration_number",
  "qualified_id": "rulesentry.government.us_immigration_number",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "4.0.0",
  "name": "US Immigration Number (A-Number)",
  "description": "Detects US Alien Registration Numbers (A-Numbers) used by USCIS. Format: 'A' prefix followed by 7-9 digits. Context-anchored to require keyword prefix (A#, alien registration, etc.) to reduce false positives.",
  "category_id": "government",
  "severity": "high",
  "profiles": [
    "government-sector",
    "ccpa",
    "production"
  ],
  "evaluation": {
    "evaluation_type": "pattern_match",
    "priority": 75,
    "target": "content",
    "pattern": {
      "pattern": "(?:A[-\\s]?#?|alien\\s+(?:registration\\s+)?(?:no|number))[-\\s:]*\\d{7,9}\\b",
      "engine": "regex",
      "flags": {
        "case_insensitive": true
      }
    },
    "effect": {
      "type": "transform",
      "rationale": "compliance",
      "transform": {
        "type": "tokenize",
        "params": {
          "prefix": "ANUMBER",
          "reversible": false
        }
      },
      "message": "US immigration number (A-Number) tokenized for de-identification"
    }
  },
  "status": "active",
  "created_at": "2026-03-17T00:00:00Z",
  "regions": [
    "US"
  ],
  "references": [
    {
      "note": "Based on OpenRedaction IMMIGRATION_NUMBER pattern"
    },
    {
      "note": "USCIS Alien Registration Number format"
    }
  ],
  "modified_at": "2026-03-21T00:00:00Z"
}
