{
  "$schema": "https://schemas.rulesentry.io/v5/catalog/rule.schema.json",
  "id": "government.us_passport",
  "qualified_id": "rulesentry.government.us_passport",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "4.0.0",
  "name": "US Passport Number",
  "description": "Detects US passport numbers. Format: 9 digits (old) or 1 letter + 8 digits (new).\n\nFormat: XXXXXXXXX or AXXXXXXXX",
  "category_id": "government",
  "severity": "high",
  "profiles": [
    "government-sector",
    "ccpa",
    "production"
  ],
  "evaluation": {
    "evaluation_type": "pattern_match",
    "priority": 90,
    "target": "content",
    "pattern": {
      "pattern": "\\b(?:passport|passport\\s+no|passport\\s+number)[:\\s]+(?:[A-Z]\\d{8}|\\d{9})\\b",
      "engine": "regex",
      "flags": {
        "case_insensitive": true
      }
    },
    "effect": {
      "type": "transform",
      "rationale": "compliance",
      "transform": {
        "type": "tokenize",
        "params": {
          "prefix": "PASSPORT",
          "reversible": false
        }
      },
      "message": "US passport number tokenized for de-identification"
    }
  },
  "status": "active",
  "created_at": "2026-01-27T00:00:00Z",
  "regions": [
    "US"
  ],
  "references": [
    {
      "note": "Based on OpenRedaction community patterns"
    },
    {
      "url": "https://github.com/openredact/openredact"
    }
  ],
  "modified_at": "2026-03-21T00:00:00Z"
}
