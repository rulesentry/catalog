{
  "$schema": "https://schemas.rulesentry.io/v5/catalog/rule.schema.json",
  "id": "healthcare.health_insurance_member_id",
  "qualified_id": "rulesentry.healthcare.health_insurance_member_id",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "4.0.1",
  "name": "Health Insurance Member ID",
  "description": "Detects health insurance member/subscriber/policy identification numbers. Format: 6-20 alphanumeric characters with contextual keywords (member, subscriber, policy).\n\nOfficial name: Health Insurance Member Identifier\nPHI category: Health Plan Beneficiary Number\nHIPAA category: Health plan beneficiary numbers",
  "category_id": "healthcare",
  "severity": "high",
  "profiles": [
    "healthcare-industry",
    "hipaa",
    "healthcare",
    "phi-detection",
    "production"
  ],
  "evaluation": {
    "evaluation_type": "pattern_match",
    "target": "content",
    "pattern": {
      "pattern": "(?i)\\b(?:member|subscriber|policy)\\s*(?:id|number|#)\\s*:?\\s*([A-Z0-9]{6,20})\\b",
      "engine": "regex"
    },
    "effect": {
      "type": "transform",
      "rationale": "compliance",
      "transform": {
        "type": "tokenize",
        "params": {
          "prefix": "INSURANCE",
          "reversible": false
        }
      },
      "message": "Health insurance member ID tokenized for de-identification"
    }
  },
  "status": "active",
  "created_at": "2026-01-28T00:00:00Z",
  "regions": [
    "US"
  ],
  "references": [
    {
      "note": "HIPAA Privacy Rule 45 CFR 164.514(b)(2)"
    }
  ],
  "modified_at": "2026-04-23T00:00:00Z"
}
