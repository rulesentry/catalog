{
  "$schema": "https://schemas.rulesentry.io/v5/catalog/rule.schema.json",
  "id": "healthcare.health_insurance_number",
  "qualified_id": "rulesentry.healthcare.health_insurance_number",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "4.0.0",
  "name": "Health Insurance Number",
  "description": "Detects health insurance/plan numbers with explicit context. Includes member ID, policy number, subscriber ID. HIPAA PHI.\n\nNote: HIPAA Protected Health Information (PHI)",
  "category_id": "healthcare",
  "severity": "high",
  "profiles": [
    "healthcare-industry",
    "hipaa",
    "production"
  ],
  "evaluation": {
    "evaluation_type": "pattern_match",
    "priority": 85,
    "target": "content",
    "pattern": {
      "pattern": "\\b(?:Health\\s+Insurance|Insurance\\s+Policy|Member\\s+ID|Subscriber\\s+ID|Policy\\s+Number)[:\\s]+[A-Z0-9-]{6,20}\\b",
      "engine": "regex",
      "flags": {
        "case_insensitive": true
      }
    },
    "effect": {
      "type": "transform",
      "rationale": "compliance",
      "transform": {
        "type": "tokenize",
        "params": {
          "prefix": "INSURANCE",
          "reversible": false
        }
      },
      "message": "Health insurance number tokenized for de-identification"
    }
  },
  "status": "active",
  "created_at": "2026-01-27T00:00:00Z",
  "regions": [
    "GLOBAL"
  ],
  "references": [
    {
      "note": "Based on OpenRedaction community patterns"
    },
    {
      "url": "https://github.com/openredact/openredact"
    }
  ],
  "modified_at": "2026-03-21T00:00:00Z"
}
