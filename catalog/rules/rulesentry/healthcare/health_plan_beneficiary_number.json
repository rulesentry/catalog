{
  "$schema": "https://schemas.rulesentry.io/v5/catalog/rule.schema.json",
  "id": "healthcare.health_plan_beneficiary_number",
  "qualified_id": "rulesentry.healthcare.health_plan_beneficiary_number",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "4.0.0",
  "name": "Health Plan Beneficiary Number",
  "description": "Detects health plan group numbers and beneficiary identifiers. Format: 5-15 alphanumeric characters with contextual keywords (group, plan, beneficiary).\n\nOfficial name: Health Plan Beneficiary Number\nPHI category: Health Plan Beneficiary Number\nHIPAA category: Health plan beneficiary numbers",
  "category_id": "healthcare",
  "severity": "high",
  "profiles": [
    "healthcare-industry",
    "hipaa",
    "production"
  ],
  "evaluation": {
    "evaluation_type": "pattern_match",
    "target": "content",
    "pattern": {
      "pattern": "(?i)\\b(?:group|plan|beneficiary)\\s*(?:number|#|no)?\\s*:\\s*([A-Z0-9]{5,15})\\b",
      "engine": "regex"
    },
    "effect": {
      "type": "transform",
      "rationale": "compliance",
      "transform": {
        "type": "tokenize",
        "params": {
          "prefix": "HPBN",
          "reversible": false
        }
      },
      "message": "Health plan beneficiary number tokenized for de-identification"
    }
  },
  "status": "active",
  "created_at": "2026-01-28T00:00:00Z",
  "regions": [
    "US"
  ],
  "references": [
    {
      "note": "HIPAA Privacy Rule 45 CFR 164.514(b)(2)"
    }
  ],
  "modified_at": "2026-03-21T00:00:00Z"
}
