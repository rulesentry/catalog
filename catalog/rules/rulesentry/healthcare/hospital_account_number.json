{
  "$schema": "https://schemas.rulesentry.io/v5/catalog/rule.schema.json",
  "id": "healthcare.hospital_account_number",
  "qualified_id": "rulesentry.healthcare.hospital_account_number",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "4.0.0",
  "name": "Hospital Account Number",
  "description": "Detects hospital and facility patient account numbers and encounter identifiers. Format: 6-12 alphanumeric characters with contextual keywords (hospital account, facility account, patient account, hospital, facility).\n\nOfficial name: Hospital Account Number\nPHI category: Account Number\nHIPAA category: Account numbers",
  "category_id": "healthcare",
  "severity": "high",
  "profiles": [
    "healthcare-industry",
    "hipaa",
    "production"
  ],
  "evaluation": {
    "evaluation_type": "pattern_match",
    "target": "content",
    "pattern": {
      "pattern": "(?i)\\b(?:hospital\\s+account|facility\\s+account|patient\\s+account|hospital|facility)\\s*(?:(?:number|#|id)\\s*:?\\s*|:\\s*)([A-Z0-9]{6,12})\\b",
      "engine": "regex"
    },
    "effect": {
      "type": "transform",
      "rationale": "compliance",
      "transform": {
        "type": "tokenize",
        "params": {
          "prefix": "HOSP_ACCT",
          "reversible": false
        }
      },
      "message": "Hospital account number tokenized for de-identification"
    }
  },
  "status": "active",
  "created_at": "2026-01-28T00:00:00Z",
  "regions": [
    "US"
  ],
  "references": [
    {
      "note": "HIPAA Privacy Rule 45 CFR 164.514(b)(2)"
    }
  ],
  "modified_at": "2026-03-21T00:00:00Z"
}
