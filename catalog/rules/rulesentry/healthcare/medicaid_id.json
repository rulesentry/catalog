{
  "$schema": "https://schemas.rulesentry.io/v5/catalog/rule.schema.json",
  "id": "healthcare.medicaid_id",
  "qualified_id": "rulesentry.healthcare.medicaid_id",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "4.0.0",
  "name": "Medicaid ID Number",
  "description": "Detects state Medicaid identification numbers with contextual keywords. Format varies by state, typically 8-13 alphanumeric characters. Pattern looks for 'medicaid' keyword followed by identifier.\n\nOfficial name: Medicaid Identification Number\nPHI category: Health Plan Beneficiary Number\nHIPAA category: Health plan beneficiary numbers",
  "category_id": "healthcare",
  "severity": "critical",
  "profiles": [
    "healthcare-industry",
    "hipaa",
    "production"
  ],
  "evaluation": {
    "evaluation_type": "pattern_match",
    "target": "content",
    "pattern": {
      "pattern": "(?i)\\b(?:medicaid\\s*(?:id|number|#)?\\s*:?\\s*)([A-Z0-9]{8,13})\\b",
      "engine": "regex"
    },
    "effect": {
      "type": "transform",
      "rationale": "compliance",
      "transform": {
        "type": "tokenize",
        "params": {
          "prefix": "MEDICAID",
          "reversible": false
        }
      },
      "message": "Medicaid ID tokenized for de-identification"
    }
  },
  "status": "active",
  "created_at": "2026-01-28T00:00:00Z",
  "regions": [
    "US"
  ],
  "references": [
    {
      "note": "HIPAA Privacy Rule 45 CFR 164.514(b)(2)"
    }
  ],
  "modified_at": "2026-03-21T00:00:00Z"
}
