{
  "$schema": "https://schemas.rulesentry.io/v5/catalog/rule.schema.json",
  "id": "healthcare.medical_device_identifier",
  "qualified_id": "rulesentry.healthcare.medical_device_identifier",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "4.0.0",
  "name": "Medical Device UDI",
  "description": "Detects FDA Unique Device Identifiers (UDI) for medical devices. Format: 8-30 alphanumeric characters with contextual keywords (udi, device id).\n\nOfficial name: Unique Device Identifier\nPHI category: Device Identifier\nHIPAA category: Device identifiers and serial numbers",
  "category_id": "healthcare",
  "severity": "medium",
  "profiles": [
    "healthcare-industry",
    "hipaa",
    "production"
  ],
  "evaluation": {
    "evaluation_type": "pattern_match",
    "target": "content",
    "pattern": {
      "pattern": "(?i)\\b(?:udi|device\\s*id)\\s*:?\\s*([A-Z0-9]{8,30})\\b",
      "engine": "regex"
    },
    "effect": {
      "type": "transform",
      "rationale": "compliance",
      "transform": {
        "type": "tokenize",
        "params": {
          "prefix": "UDI",
          "reversible": false
        }
      },
      "message": "Medical device identifier tokenized for de-identification"
    }
  },
  "status": "active",
  "created_at": "2026-01-28T00:00:00Z",
  "regions": [
    "US"
  ],
  "references": [
    {
      "note": "HIPAA Privacy Rule 45 CFR 164.514(b)(2)"
    }
  ],
  "modified_at": "2026-03-21T00:00:00Z"
}
