{
  "$schema": "https://schemas.rulesentry.io/v5/catalog/rule.schema.json",
  "id": "healthcare.medical_license_number",
  "qualified_id": "rulesentry.healthcare.medical_license_number",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "4.0.0",
  "name": "Medical License Number",
  "description": "Detects state medical board license numbers for physicians and healthcare providers. Format: 1-3 letters + 4-9 digits (varies by state).\n\nOfficial name: State Medical License Number\nPHI category: Provider Identifier\nHIPAA category: Certificate/license numbers",
  "category_id": "healthcare",
  "severity": "medium",
  "profiles": [
    "healthcare-industry",
    "hipaa",
    "production"
  ],
  "evaluation": {
    "evaluation_type": "pattern_match",
    "target": "content",
    "pattern": {
      "pattern": "(?i)\\b(?:medical\\s*)?license\\s*(?:number|#)?\\s*:?\\s*([A-Z]{1,3}\\d{4,9})\\b",
      "engine": "regex"
    },
    "effect": {
      "type": "transform",
      "rationale": "compliance",
      "transform": {
        "type": "tokenize",
        "params": {
          "prefix": "MED_LIC",
          "reversible": false
        }
      },
      "message": "Medical license number tokenized for de-identification"
    }
  },
  "status": "active",
  "created_at": "2026-01-28T00:00:00Z",
  "regions": [
    "US"
  ],
  "references": [
    {
      "note": "HIPAA Privacy Rule 45 CFR 164.514(b)(2)"
    }
  ],
  "modified_at": "2026-03-21T00:00:00Z"
}
