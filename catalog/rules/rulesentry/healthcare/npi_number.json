{
  "$schema": "https://schemas.rulesentry.io/v5/catalog/rule.schema.json",
  "id": "healthcare.npi_number",
  "qualified_id": "rulesentry.healthcare.npi_number",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "4.0.0",
  "name": "National Provider Identifier (NPI)",
  "description": "Detects National Provider Identifier (NPI) numbers with Luhn checksum validation. 10-digit unique identifier for healthcare providers in the US. Format: 1234567893.\n\nOfficial name: National Provider Identifier\nPHI category: Provider Identifier\nHIPAA category: National provider identifier",
  "category_id": "healthcare",
  "severity": "high",
  "profiles": [
    "healthcare-industry",
    "hipaa",
    "healthcare",
    "phi-detection",
    "production"
  ],
  "evaluation": {
    "evaluation_type": "pattern_match",
    "target": "content",
    "pattern": {
      "pattern": "\\b[1-9]\\d{9}\\b",
      "engine": "regex",
      "validator": "npi_luhn"
    },
    "effect": {
      "type": "transform",
      "rationale": "compliance",
      "transform": {
        "type": "tokenize",
        "params": {
          "prefix": "NPI",
          "reversible": false
        }
      },
      "message": "NPI number tokenized (NPI Luhn validated) for de-identification"
    }
  },
  "status": "active",
  "created_at": "2026-01-28T00:00:00Z",
  "regions": [
    "US"
  ],
  "references": [
    {
      "note": "HIPAA Privacy Rule 45 CFR 164.514(b)(2)"
    }
  ],
  "modified_at": "2026-03-21T00:00:00Z"
}
