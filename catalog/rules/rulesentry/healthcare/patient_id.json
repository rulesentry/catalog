{
  "$schema": "https://schemas.rulesentry.io/v5/catalog/rule.schema.json",
  "id": "healthcare.patient_id",
  "qualified_id": "rulesentry.healthcare.patient_id",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "4.0.0",
  "name": "Patient ID",
  "description": "Detects patient identification numbers with explicit 'Patient ID:', 'Patient Number:', or similar context. HIPAA PHI.\n\nNote: HIPAA Protected Health Information (PHI)",
  "category_id": "healthcare",
  "severity": "critical",
  "profiles": [
    "healthcare-industry",
    "hipaa",
    "production"
  ],
  "evaluation": {
    "evaluation_type": "pattern_match",
    "priority": 90,
    "target": "content",
    "pattern": {
      "pattern": "\\b(?:Patient\\s+(?:ID|Identifier|Number|No\\.?|#))[:\\s]+[A-Z0-9-]{6,20}\\b",
      "engine": "regex",
      "flags": {
        "case_insensitive": true
      }
    },
    "effect": {
      "type": "transform",
      "rationale": "compliance",
      "transform": {
        "type": "tokenize",
        "params": {
          "prefix": "PATIENT",
          "reversible": false
        }
      },
      "message": "Patient ID tokenized for de-identification"
    }
  },
  "status": "active",
  "created_at": "2026-01-27T00:00:00Z",
  "regions": [
    "US"
  ],
  "references": [
    {
      "note": "Based on OpenRedaction community patterns"
    },
    {
      "url": "https://github.com/openredact/openredact"
    }
  ],
  "modified_at": "2026-03-21T00:00:00Z"
}
