{
  "$schema": "https://schemas.rulesentry.io/v5/catalog/rule.schema.json",
  "id": "legal.case_caption",
  "qualified_id": "rulesentry.legal.case_caption",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "1.2.0",
  "status": "active",
  "name": "Case Caption / Case Style",
  "description": "Detects US litigation case captions that identify parties: 'Smith v. Jones', 'In re: Company Name', 'People v. Defendant'. Per ABA Formal Opinion 512, party names must be removed or tokenized to prevent matter identification when submitting to AI.",
  "category_id": "legal",
  "severity": "critical",
  "profiles": [
    "aba-ethics",
    "production"
  ],
  "regions": [
    "US"
  ],
  "tags": [
    "case-caption",
    "parties",
    "litigation",
    "legal"
  ],
  "evaluation": {
    "evaluation_type": "pattern_match",
    "priority": 95,
    "target": "content",
    "pattern": {
      "pattern": "(?:(?:In\\s+(?:re|the\\s+Matter\\s+of))\\s*[:\\s]+[A-Z][A-Za-z\\s&'-]+|(?:[A-Z][A-Za-z'-]+(?:\\s+[A-Za-z]{2}[A-Za-z.&'-]*){0,4}(?:,\\s*(?:Inc\\.|LLC|LLP|Ltd\\.|Corp\\.|Co\\.))?\\s+v\\.?\\s+[A-Z][A-Za-z'-]+(?:\\s+[A-Za-z]{2}[A-Za-z.&'-]*){0,4}(?:,\\s*(?:Inc\\.|LLC|LLP|Ltd\\.|Corp\\.|Co\\.))?)|(?:(?:People|State|Commonwealth|United\\s+States)\\s+v\\.?\\s+[A-Z][A-Za-z'-]+(?:\\s+[A-Za-z]{2}[A-Za-z.&'-]*){0,4}))",
      "engine": "regex",
      "flags": {
        "case_insensitive": false
      }
    },
    "effect": {
      "type": "transform",
      "rationale": "compliance",
      "transform": {
        "type": "tokenize",
        "params": {
          "prefix": "CASE",
          "reversible": false
        }
      },
      "message": "Case caption tokenized to prevent matter identification per ABA Formal Opinion 512"
    }
  },
  "created_at": "2026-06-03T00:00:00Z",
  "modified_at": "2026-07-23T00:00:00Z",
  "modified_by": "claude-code"
}
