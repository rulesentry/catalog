{
  "$schema": "https://schemas.rulesentry.io/v5/catalog/rule.schema.json",
  "id": "legal_privilege.docket_number",
  "qualified_id": "rulesentry.legal_privilege.docket_number",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "1.0.0",
  "status": "active",
  "name": "Court Docket / Case Number",
  "description": "Detects US federal (2:24-cv-01234) and state (Case No. 2024-CV-1234) docket numbers that identify matters in public records. Docket numbers enable anyone with the number to retrieve the full public record of a matter. Maps to LEGAL_CASE_NUMBER canonical type.",
  "category_id": "legal_privilege",
  "severity": "critical",
  "profiles": [
    "aba-ethics",
    "production"
  ],
  "regions": [
    "US"
  ],
  "tags": [
    "docket",
    "case-number",
    "court",
    "legal"
  ],
  "evaluation": {
    "evaluation_type": "pattern_match",
    "priority": 95,
    "target": "content",
    "pattern": {
      "pattern": "(?:(?:Case|Docket|File|Action)\\s*(?:No\\.?|Number|#)\\s*:?\\s*)?\\b\\d{1,2}:\\d{2}-[a-zA-Z]{2,4}-\\d{4,6}(?:-[A-Z]{2,4})?\\b|(?:(?:Case|Docket|File)\\s*(?:No\\.?|#)\\s*:?\\s*)\\d{2,4}[-/]?[A-Z]{0,4}[-/]?\\d{3,8}",
      "engine": "regex",
      "flags": {
        "case_insensitive": true
      }
    },
    "effect": {
      "type": "transform",
      "rationale": "compliance",
      "transform": {
        "type": "tokenize",
        "params": {
          "prefix": "DOCKET",
          "reversible": false
        }
      },
      "message": "Docket number tokenized to prevent public-record matter lookup"
    }
  },
  "created_at": "2026-06-03T00:00:00Z",
  "modified_at": "2026-06-03T00:00:00Z"
}
