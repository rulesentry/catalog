{
  "$schema": "https://schemas.rulesentry.io/v4/catalog/rule.schema.json",
  "id": "legal_privilege.settlement_amount",
  "qualified_id": "rulesentry.legal_privilege.settlement_amount",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "1.0.0",
  "status": "active",
  "name": "Settlement / Reserve / Demand Amount",
  "description": "Detects monetary amounts in legal negotiation context: settlement offers, reserve figures, demand amounts, litigation budget, and negotiation authority ranges. Per D.C. Bar Opinion 388, settlement authority and negotiation limits are core privileged strategy that must not be disclosed to AI systems.",
  "category_id": "legal_privilege",
  "severity": "critical",
  "profiles": [
    "aba-ethics",
    "production"
  ],
  "regions": [
    "US"
  ],
  "tags": [
    "settlement",
    "reserve",
    "demand",
    "negotiation",
    "legal"
  ],
  "evaluation": {
    "evaluation_type": "pattern_match",
    "priority": 85,
    "target": "content",
    "pattern": {
      "pattern": "(?:settl(?:ement|e|ed|ing)\\s+(?:amount|offer|demand|authority|value|range|figure|sum)|reserve\\s+(?:amount|of|set\\s+at)|demand\\s+(?:letter|amount|of)|litigation\\s+budget|negotiation\\s+(?:floor|ceiling|authority|limit|range)|authority\\s+(?:to\\s+settle|up\\s+to))\\s*(?:of\\s+|:?\\s*)?\\$[\\d,]+(?:\\.\\d{2})?(?:\\s*(?:million|mil|M|billion|B|thousand|K))?",
      "engine": "regex",
      "flags": {
        "case_insensitive": true
      }
    },
    "effect": {
      "type": "transform",
      "rationale": "compliance",
      "transform": {
        "type": "redact",
        "params": {
          "marker": "[SETTLEMENT_AMOUNT_REDACTED]"
        }
      },
      "message": "Settlement/reserve/demand amount redacted per D.C. Bar Opinion 388 — negotiation figures are core work product"
    }
  },
  "created_at": "2026-06-03T00:00:00Z",
  "updated_at": "2026-06-03T00:00:00Z"
}
