  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "1.0.0",
  "status": "active",
  "name": "API Key (Ettin PII)",
  "description": "Detects API keys and tokens using the Ettin 68M PII on-device ONNX model. Rule silently no-ops when no model is active.",
  "category_id": "ner",
  "severity": "critical",
  "regions": [
    "GLOBAL"
  ],
  "profiles": [
    "production"
  ],
  "tags": [
    "credentials",
    "api-key",
    "ner",
    "ettin"
  ],
  "evaluation": {
    "evaluation_type": "ner_match",
    "entity_types": [
      "api_key"
    ],
    "confidence_threshold": 0.85,
    "model": {
      "fallback": "skip"
    },
    "effect": {
      "type": "block",
      "rationale": "security",
      "message": "API key detected by Ettin PII NER — blocked to prevent credential exposure"
    }
  },
  "origin": {
