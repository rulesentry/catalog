{
  "$schema": "https://schemas.rulesentry.io/v4/catalog/rule.schema.json",
  "id": "ner.ettin_biometric_identifier",
  "qualified_id": "rulesentry.ner.ettin_biometric_identifier",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "1.0.0",
  "status": "active",
  "name": "Biometric Identifier (Ettin PII)",
  "description": "Detects biometric identifiers using the Ettin 68M PII on-device ONNX model. Biometric data is a GDPR Article 9 special category requiring the highest protection. Rule silently no-ops when no model is active.",
  "category_id": "ner",
  "severity": "critical",
  "regions": [
    "GLOBAL"
  ],
  "profiles": [
    "gdpr-special-categories",
    "ccpa",
    "production"
  ],
  "tags": [
    "pii",
    "biometric",
    "sensitive",
    "gdpr-special-category",
    "ner",
    "ettin"
  ],
  "evaluation": {
    "evaluation_type": "ner_match",
    "entity_types": [
      "biometric_identifier"
    ],
    "confidence_threshold": 0.85,
    "model": {
      "fallback": "skip"
    },
    "effect": {
      "type": "block",
      "rationale": "compliance",
      "message": "Biometric identifier detected by Ettin PII NER — blocked to prevent exposure of GDPR special category data"
    }
  },
  "origin": {
    "source_type": "catalog",
    "catalog_url": "https://catalog.rulesentry.io/rules/rulesentry/ner/ettin_biometric_identifier"
  },
