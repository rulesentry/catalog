    "evaluation_type": "ner_match",
    "entity_types": [
      "credit_debit_card"
    ],
    "confidence_threshold": 0.85,
    "model": {
      "fallback": "skip"
    },
    "effect": {
      "type": "block",
      "rationale": "compliance",
      "message": "Credit/debit card number detected by Ettin PII NER — blocked to prevent financial data exposure"
