{
  "$schema": "https://schemas.rulesentry.io/v4/catalog/rule.schema.json",
  "id": "ner.ettin_health_plan_beneficiary_number",
  "qualified_id": "rulesentry.ner.ettin_health_plan_beneficiary_number",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "1.0.0",
  "status": "active",
  "name": "Health Plan Beneficiary Number (Ettin PII)",
  "description": "Detects health plan beneficiary numbers using the Ettin 68M PII on-device ONNX model. This is a HIPAA-designated identifier in the 18 PHI identifiers list. Rule silently no-ops when no model is active.",
  "category_id": "ner",
  "severity": "medium",
  "regions": [
    "US"
  ],
  "profiles": [
    "hipaa",
    "production"
  ],
  "tags": [
    "pii",
    "medical",
    "hipaa",
    "phi",
    "ner",
    "ettin"
  ],
  "evaluation": {
    "evaluation_type": "ner_match",
    "entity_types": [
      "health_plan_beneficiary_number"
    ],
    "confidence_threshold": 0.85,
    "model": {
      "fallback": "skip"
    },
    "effect": {
      "type": "transform",
      "rationale": "compliance",
      "transform": {
        "type": "replace",
        "params": {
          "replacement": "[HEALTH_PLAN_BENEFICIARY_NUMBER]"
        }
      },
      "message": "Health Plan Beneficiary Number detected by Ettin PII NER replaced for de-identification"
    }
  },
  "origin": {
    "source_type": "catalog",
    "catalog_url": "https://catalog.rulesentry.io/rules/rulesentry/ner/ettin_health_plan_beneficiary_number"
  },
