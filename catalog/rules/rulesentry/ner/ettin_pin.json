  "type": "rule",
  "version": "1.0.0",
  "status": "active",
  "name": "PIN (Ettin PII)",
  "description": "Detects personal identification numbers (PINs) using the Ettin 68M PII on-device ONNX model. PINs are authentication credentials and must not be stored or transmitted. Rule silently no-ops when no model is active.",
  "category_id": "ner",
  "severity": "critical",
  "regions": [
    "GLOBAL"
  ],
  "profiles": [
    "pci-dss",
    "production"
  ],
  "tags": [
    "credentials",
    "financial",
    "pin",
    "ner",
    "ettin"
  ],
  "evaluation": {
    "evaluation_type": "ner_match",
    "entity_types": [
      "pin"
    ],
    "confidence_threshold": 0.85,
    "model": {
      "fallback": "skip"
    },
    "effect": {
      "type": "block",
      "rationale": "compliance",
      "message": "PIN detected by Ettin PII NER — blocked to prevent authentication credential exposure"
    }
  },
