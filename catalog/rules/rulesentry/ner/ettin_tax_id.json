{
  "$schema": "https://schemas.rulesentry.io/v4/catalog/rule.schema.json",
  "id": "ner.ettin_tax_id",
  "qualified_id": "rulesentry.ner.ettin_tax_id",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "1.0.0",
  "status": "active",
  "name": "Tax ID / TIN (Ettin PII)",
  "description": "Detects tax identification numbers (TIN, EIN, VAT numbers) using the Ettin 68M PII on-device ONNX model. Rule silently no-ops when no model is active.",
  "category_id": "ner",
  "severity": "critical",
  "regions": [
    "GLOBAL"
  ],
  "profiles": [
    "production"
  ],
  "tags": [
    "pii",
    "government-id",
    "financial",
    "tax",
    "ner",
    "ettin"
  ],
  "evaluation": {
    "evaluation_type": "ner_match",
    "entity_types": [
      "tax_id"
    ],
    "confidence_threshold": 0.85,
    "model": {
      "fallback": "skip"
    },
    "effect": {
      "type": "transform",
      "rationale": "compliance",
      "transform": {
        "type": "replace",
        "params": {
          "replacement": "[TAX_ID]"
        }
      },
      "message": "Tax ID detected by Ettin PII NER replaced for de-identification"
    }
  },
  "origin": {
    "source_type": "catalog",
    "catalog_url": "https://catalog.rulesentry.io/rules/rulesentry/ner/ettin_tax_id"
  },
