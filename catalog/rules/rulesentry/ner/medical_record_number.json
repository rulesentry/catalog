{
  "$schema": "https://schemas.rulesentry.io/v4/catalog/rule.schema.json",
  "id": "ner.medical_record_number",
  "qualified_id": "rulesentry.ner.medical_record_number",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "1.0.0",
  "status": "inactive",
  "name": "Medical Record Number",
  "description": "Detects medical record numbers (MRNs) using an on-device NER model. MRNs are HIPAA-designated identifiers in the 18 PHI identifiers list. Rule silently no-ops when no model is active.",
  "category_id": "ner",
  "severity": "medium",
  "regions": [
    "US"
  ],
  "profiles": [
    "hipaa"
  ],
  "tags": [
    "pii",
    "medical",
    "hipaa",
    "phi",
    "ner"
  ],
  "evaluation": {
    "evaluation_type": "ner_match",
    "entity_types": [
      "medical_record_number"
    ],
    "confidence_threshold": 0.85,
    "model": {
      "fallback": "skip"
    },
    "effect": {
      "type": "transform",
      "rationale": "compliance",
      "transform": {
        "type": "replace",
        "params": {
          "replacement": "[MRN]"
        }
      },
      "message": "Medical record number detected by NER replaced per HIPAA PHI de-identification"
    }
  },
  "origin": {
    "source_type": "catalog",
    "catalog_url": "https://catalog.rulesentry.io/rules/rulesentry/ner/medical_record_number"
  },
  "created_at": "2026-05-24T00:00:00Z",
  "created_by": "claude-code",
  "modified_at": "2026-05-26T00:00:00Z",
