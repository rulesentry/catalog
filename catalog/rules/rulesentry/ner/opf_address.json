{
  "$schema": "https://schemas.rulesentry.io/v4/catalog/rule.schema.json",
  "id": "ner.opf_address",
  "qualified_id": "rulesentry.ner.opf_address",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "1.0.0",
  "status": "active",
  "name": "Address (OPF)",
  "description": "Detects street addresses, postal codes, and location identifiers using the OpenAI Privacy Filter (OPF) sidecar. PRIVATE_ADDRESS entity type. Requires an active OPF sidecar (configured in Settings → Runtime Services). Rule silently no-ops when no sidecar is active.",
  "category_id": "ner",
  "severity": "high",
  "regions": [
    "GLOBAL"
  ],
  "profiles": [
    "gdpr",
    "ccpa",
    "production"
  ],
  "tags": [
    "pii",
    "address",
    "ner",
    "opf"
  ],
  "evaluation": {
    "evaluation_type": "ner_match",
    "entity_types": [
      "PRIVATE_ADDRESS"
    ],
    "confidence_threshold": 0.5,
    "model": {
      "fallback": "skip"
    },
    "effect": {
      "type": "transform",
      "rationale": "compliance",
      "transform": {
        "type": "replace",
        "params": {
          "replacement": "[ADDRESS]"
        }
      },
      "message": "Address detected by OPF replaced for de-identification"
    }
  },
  "origin": {
    "source_type": "local"
  },
  "created_at": "2026-04-27T00:00:00Z",
  "created_by": "claude-code",
  "modified_at": "2026-04-27T00:00:00Z",
  "modified_by": "claude-code"
}
