{
  "$schema": "https://schemas.rulesentry.io/v5/catalog/rule.schema.json",
  "id": "ner.political_view",
  "qualified_id": "rulesentry.ner.political_view",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "1.0.0",
  "status": "active",
  "name": "Political View",
  "description": "Detects political opinions and views using an on-device NER model. Political opinions are a GDPR Article 9 special category requiring explicit consent to process. Rule silently no-ops when no model is active.",
  "category_id": "ner",
  "severity": "medium",
  "regions": [
    "GLOBAL"
  ],
  "profiles": [
    "gdpr-special-categories",
    "production"
  ],
  "tags": [
    "pii",
    "sensitive",
    "gdpr-special-category",
    "political",
    "ner"
  ],
  "evaluation": {
    "evaluation_type": "ner_match",
    "entity_types": [
      "political_view"
    ],
    "confidence_threshold": 0.85,
    "model": {
      "fallback": "skip"
    },
    "effect": {
      "type": "transform",
      "rationale": "compliance",
      "transform": {
        "type": "replace",
        "params": {
          "replacement": "[POLITICAL_VIEW]"
        }
      },
      "message": "Political View detected by NER replaced for de-identification"
    }
  },
  "origin": {
    "source_type": "catalog",
    "catalog_url": "https://catalog.rulesentry.io/rules/rulesentry/ner/political_view"
  },
  "created_at": "2026-05-24T00:00:00Z",
  "created_by": "claude-code",
  "modified_at": "2026-05-25T00:00:00Z",
  "modified_by": "claude-code"
}
