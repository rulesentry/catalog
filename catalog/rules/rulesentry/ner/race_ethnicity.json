{
  "$schema": "https://schemas.rulesentry.io/v4/catalog/rule.schema.json",
  "id": "ner.race_ethnicity",
  "qualified_id": "rulesentry.ner.race_ethnicity",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "1.0.0",
  "status": "active",
  "name": "Race / Ethnicity",
  "description": "Detects racial and ethnic origin information using an on-device NER model. Racial/ethnic data is a GDPR Article 9 special category. Rule silently no-ops when no model is active.",
  "category_id": "ner",
  "severity": "medium",
  "regions": [
    "GLOBAL"
  ],
  "profiles": [
    "gdpr-special-categories",
    "ccpa",
    "production"
  ],
  "tags": [
    "pii",
    "sensitive",
    "gdpr-special-category",
    "demographic",
    "ner"
  ],
  "evaluation": {
    "evaluation_type": "ner_match",
    "entity_types": [
      "race_ethnicity"
    ],
    "confidence_threshold": 0.85,
    "model": {
      "fallback": "skip"
    },
    "effect": {
      "type": "transform",
      "rationale": "compliance",
      "transform": {
        "type": "replace",
        "params": {
          "replacement": "[RACE_ETHNICITY]"
        }
      },
      "message": "Race/ethnicity detected by NER replaced for de-identification"
    }
  },
  "origin": {
    "source_type": "catalog",
    "catalog_url": "https://catalog.rulesentry.io/rules/rulesentry/ner/race_ethnicity"
  },
  "created_at": "2026-05-24T00:00:00Z",
  "created_by": "claude-code",
  "modified_at": "2026-05-25T00:00:00Z",
  "modified_by": "claude-code"
}
