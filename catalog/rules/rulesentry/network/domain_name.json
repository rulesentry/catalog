{
  "$schema": "https://schemas.rulesentry.io/v5/catalog/rule.schema.json",
  "id": "network.domain_name",
  "qualified_id": "rulesentry.network.domain_name",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "4.0.0",
  "name": "Domain Name",
  "description": "Detects domain names (e.g., example.com, subdomain.example.co.uk). Excludes common email patterns to avoid false positives.\n\nNote: May match domains in emails; email rules will match full addresses with higher priority. Uses tld_reject validator to exclude common file extensions (txt, pdf, json, etc.) from matching as domain TLDs.",
  "category_id": "network",
  "severity": "info",
  "profiles": [
    "production"
  ],
  "evaluation": {
    "evaluation_type": "pattern_match",
    "priority": 55,
    "target": "content",
    "pattern": {
      "pattern": "\\b[A-Za-z0-9][-A-Za-z0-9]{0,62}(?:\\.[A-Za-z0-9][-A-Za-z0-9]{0,62})*\\.[A-Za-z]{2,}\\b",
      "engine": "regex",
      "validator": "tld_reject",
      "validator_params": {
        "reject_tlds": [
          "txt",
          "csv",
          "json",
          "xml",
          "yml",
          "yaml",
          "toml",
          "log",
          "md",
          "pdf",
          "doc",
          "docx",
          "xls",
          "xlsx",
          "ppt",
          "pptx",
          "zip",
          "tar",
          "gz",
          "rar",
          "exe",
          "dll",
          "bat",
          "sh",
          "png",
          "jpg",
          "jpeg",
          "gif",
          "svg",
          "webp",
          "ico",
          "css",
          "scss",
          "wasm",
          "map"
        ]
      }
    },
    "effect": {
      "type": "info",
      "message": "Domain name detected (informational only)"
    }
  },
  "status": "active",
  "created_at": "2026-01-27T00:00:00Z",
  "regions": [
    "GLOBAL"
  ],
  "references": [
    {
      "note": "Based on OpenRedaction community patterns"
    },
    {
      "url": "https://github.com/openredact/openredact"
    }
  ],
  "modified_at": "2026-01-27T19:52:26.963484Z"
}
