{
  "$schema": "https://schemas.rulesentry.io/v5/catalog/rule.schema.json",
  "id": "network.unc_path",
  "qualified_id": "rulesentry.network.unc_path",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "4.0.0",
  "name": "UNC Network Path",
  "description": "Detects Windows UNC (Universal Naming Convention) network paths (e.g., \\\\\\\\server\\\\share\\\\file). May reveal internal network structure.\n\nFormat: \\\\\\\\server\\\\share\\\\path",
  "category_id": "network",
  "severity": "low",
  "profiles": [
    "production"
  ],
  "evaluation": {
    "evaluation_type": "pattern_match",
    "priority": 60,
    "target": "content",
    "pattern": {
      "pattern": "\\\\\\\\[A-Za-z0-9._-]+\\\\[A-Za-z0-9._$ -]+(?:\\\\[^\\s\\\\]*)*",
      "engine": "regex"
    },
    "effect": {
      "type": "transform",
      "rationale": "inference",
      "transform": {
        "type": "replace",
        "params": {
          "replacement": "[UNC_PATH]"
        }
      },
      "message": "UNC path replaced"
    }
  },
  "status": "active",
  "created_at": "2026-01-27T00:00:00Z",
  "regions": [
    "GLOBAL"
  ],
  "references": [
    {
      "note": "Based on OpenRedaction community patterns"
    },
    {
      "url": "https://github.com/openredact/openredact"
    }
  ],
  "modified_at": "2026-01-27T19:52:26.963484Z"
}
