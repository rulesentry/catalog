{
  "$schema": "https://schemas.rulesentry.io/v5/catalog/rule.schema.json",
  "id": "personal.biometric_data",
  "qualified_id": "rulesentry.personal.biometric_data",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "4.0.0",
  "name": "Biometric Data (Height/Weight)",
  "description": "Detects height and weight measurements with context. Can be considered biometric/health data under GDPR when linked to an individual.\n\nNote: May be GDPR Article 9 special category data in healthcare context",
  "category_id": "personal",
  "severity": "medium",
  "profiles": [
    "hipaa",
    "gdpr",
    "production"
  ],
  "evaluation": {
    "evaluation_type": "pattern_match",
    "priority": 65,
    "target": "content",
    "pattern": {
      "pattern": "\\b(?:Height|Weight)[:\\s]+\\d+(?:\\.\\d+)?\\s*(?:cm|m|ft|in|kg|lbs?|pounds?)\\b",
      "engine": "regex",
      "flags": {
        "case_insensitive": true
      }
    },
    "effect": {
      "type": "transform",
      "rationale": "compliance",
      "transform": {
        "type": "replace",
        "params": {
          "replacement": "[BIOMETRIC]"
        }
      },
      "message": "Biometric data (height/weight) replaced"
    }
  },
  "status": "active",
  "created_at": "2026-01-27T00:00:00Z",
  "regions": [
    "GLOBAL"
  ],
  "references": [
    {
      "note": "Based on OpenRedaction community patterns"
    },
    {
      "url": "https://github.com/openredact/openredact"
    }
  ],
  "modified_at": "2026-01-27T19:52:26.987271Z"
}
