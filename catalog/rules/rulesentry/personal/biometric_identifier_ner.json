{
  "$schema": "https://schemas.rulesentry.io/v5/catalog/rule.schema.json",
  "id": "personal.biometric_identifier_ner",
  "qualified_id": "rulesentry.personal.biometric_identifier_ner",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "1.0.0",
  "status": "active",
  "name": "Biometric Identifier",
  "description": "Detects biometric identifiers using an on-device NER model. Biometric data is a GDPR Article 9 special category requiring the highest protection. Rule silently no-ops when no model is active.",
  "category_id": "personal",
  "severity": "medium",
  "regions": [
    "GLOBAL"
  ],
  "profiles": [
    "gdpr-special-categories",
    "ccpa",
    "production"
  ],
  "tags": [
    "pii",
    "biometric",
    "sensitive",
    "gdpr-special-category",
    "ner"
  ],
  "evaluation": {
    "evaluation_type": "ner_match",
    "entity_types": [
      "biometric_identifier"
    ],
    "confidence_threshold": 0.85,
    "model": {
      "fallback": "skip"
    },
    "effect": {
      "type": "transform",
      "rationale": "compliance",
      "transform": {
        "type": "replace",
        "params": {
          "replacement": "[BIOMETRIC_IDENTIFIER]"
        }
      },
      "message": "Biometric Identifier detected by NER replaced for de-identification"
    }
  },
  "origin": {
    "source_type": "catalog",
    "catalog_url": "https://catalog.rulesentry.io/rules/rulesentry/personal/biometric_identifier_ner"
  },
  "created_at": "2026-05-24T00:00:00Z",
  "created_by": "claude-code",
  "modified_at": "2026-07-23T00:00:00Z",
  "modified_by": "claude-code"
}
