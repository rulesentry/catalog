{
  "$schema": "https://schemas.rulesentry.io/v5/catalog/rule.schema.json",
  "id": "personal.date",
  "qualified_id": "rulesentry.personal.date",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "4.0.0",
  "name": "Date",
  "description": "Detects standalone dates in numeric (MM/DD/YYYY, DD/MM/YYYY) and written month formats (March 10, 2026 / 28 February 2026). Low severity — bare dates are ambiguous without surrounding context.\n\nFormats: MM/DD/YYYY, DD/MM/YYYY, MM-DD-YYYY, DD-MM-YYYY, Month DD, YYYY, Month DDth, YYYY, DD Month YYYY\nNote: Companion to personal.date_of_birth. Use that rule for higher-confidence context-anchored matches (with 'DOB:' or 'Date of Birth:' prefix). This rule catches bare dates without a label.",
  "category_id": "personal",
  "severity": "low",
  "profiles": [
    "hipaa",
    "gdpr"
  ],
  "evaluation": {
    "evaluation_type": "pattern_match",
    "priority": 70,
    "target": "content",
    "pattern": {
      "pattern": "\\b(?:(?:0?[1-9]|1[0-2])[/-](?:0?[1-9]|[12]\\d|3[01])[/-](?:19|20)\\d{2}|(?:Jan(?:uary)?|Feb(?:ruary)?|Mar(?:ch)?|Apr(?:il)?|May|Jun(?:e)?|Jul(?:y)?|Aug(?:ust)?|Sep(?:tember)?|Oct(?:ober)?|Nov(?:ember)?|Dec(?:ember)?)\\s+\\d{1,2}(?:st|nd|rd|th)?,?\\s+(?:19|20)\\d{2}|\\d{1,2}(?:st|nd|rd|th)?\\s+(?:Jan(?:uary)?|Feb(?:ruary)?|Mar(?:ch)?|Apr(?:il)?|May|Jun(?:e)?|Jul(?:y)?|Aug(?:ust)?|Sep(?:tember)?|Oct(?:ober)?|Nov(?:ember)?|Dec(?:ember)?)\\s+(?:19|20)\\d{2})\\b",
      "engine": "regex",
      "flags": {
        "case_insensitive": true
      }
    },
    "effect": {
      "type": "transform",
      "rationale": "compliance",
      "transform": {
        "type": "redact",
        "params": {
          "marker": "[DATE]"
        }
      },
      "message": "Date redacted"
    }
  },
  "status": "active",
  "created_at": "2026-03-17T00:00:00Z",
  "regions": [
    "GLOBAL"
  ],
  "modified_at": "2026-06-02T00:00:00Z"
}
