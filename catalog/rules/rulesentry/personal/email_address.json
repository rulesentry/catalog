{
  "$schema": "https://schemas.rulesentry.io/v5/catalog/rule.schema.json",
  "id": "personal.email_address",
  "qualified_id": "rulesentry.personal.email_address",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "4.0.1",
  "name": "Email Address",
  "description": "Detects email addresses using RFC 5322 compliant pattern. Includes support for international domains (IDN), subdomains, and plus addressing (user+tag@domain.com).\n\nSupports: plus addressing, subdomains, international domains",
  "category_id": "personal",
  "severity": "medium",
  "profiles": [
    "gdpr",
    "ccpa",
    "pipeda",
    "production"
  ],
  "evaluation": {
    "evaluation_type": "pattern_match",
    "priority": 70,
    "target": "content",
    "pattern": {
      "pattern": "\\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}\\b",
      "engine": "regex",
      "validator": "tld_reject",
      "validator_params": {
        "reject_tlds": [
          "txt",
          "pdf",
          "doc",
          "docx",
          "xls",
          "xlsx",
          "csv",
          "jpg",
          "jpeg",
          "png",
          "gif",
          "bmp",
          "svg",
          "webp",
          "zip",
          "tar",
          "gz",
          "rar",
          "7z",
          "exe",
          "dll",
          "bat",
          "sh",
          "bin",
          "html",
          "htm",
          "xml",
          "json",
          "yaml",
          "yml",
          "mp3",
          "mp4",
          "avi",
          "mov",
          "wav",
          "test",
          "example",
          "invalid",
          "localhost",
          "local",
          "internal",
          "intranet",
          "private",
          "corp",
          "home",
          "lan",
          "foo",
          "bar",
          "baz",
          "qux"
        ]
      }
    },
    "effect": {
      "type": "transform",
      "rationale": "verification",
      "transform": {
        "type": "redact",
        "params": {
          "marker": "[Email-Redacted]"
        }
      },
      "message": "Email address redacted"
    }
  },
  "status": "active",
  "created_at": "2026-01-27T00:00:00Z",
  "regions": [
    "GLOBAL"
  ],
  "references": [
    {
      "note": "Based on OpenRedaction community patterns"
    },
    {
      "url": "https://github.com/openredact/openredact"
    },
    {
      "note": "RFC 5322"
    }
  ],
  "modified_at": "2026-07-23T00:00:00Z",
  "modified_by": "claude-code"
}
