{
  "$schema": "https://schemas.rulesentry.io/v5/catalog/rule.schema.json",
  "id": "personal.gender_marker",
  "qualified_id": "rulesentry.personal.gender_marker",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "4.0.0",
  "name": "Gender Marker",
  "description": "Detects explicit gender markers with context (e.g., 'Gender: Male', 'Sex: F'). Considered sensitive personal data under GDPR Article 9.\n\nNote: GDPR Article 9 - special category data",
  "category_id": "personal",
  "severity": "medium",
  "profiles": [
    "hipaa",
    "gdpr",
    "production"
  ],
  "evaluation": {
    "evaluation_type": "pattern_match",
    "priority": 70,
    "target": "content",
    "pattern": {
      "pattern": "\\b(?:Gender|Sex)[:\\s]+(?:Male|Female|M|F|Non-binary|Other|Prefer\\s+not\\s+to\\s+say)\\b",
      "engine": "regex",
      "flags": {
        "case_insensitive": true
      }
    },
    "effect": {
      "type": "transform",
      "rationale": "compliance",
      "transform": {
        "type": "replace",
        "params": {
          "replacement": "[GENDER]"
        }
      },
      "message": "Gender marker replaced per GDPR Article 9"
    }
  },
  "status": "active",
  "created_at": "2026-01-27T00:00:00Z",
  "regions": [
    "GLOBAL"
  ],
  "references": [
    {
      "note": "Based on OpenRedaction community patterns"
    },
    {
      "url": "https://github.com/openredact/openredact"
    }
  ],
  "modified_at": "2026-01-27T19:52:26.987271Z"
}
