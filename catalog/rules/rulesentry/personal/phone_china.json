{
  "$schema": "https://schemas.rulesentry.io/v5/catalog/rule.schema.json",
  "id": "personal.phone_china",
  "qualified_id": "rulesentry.personal.phone_china",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "4.0.0",
  "name": "Chinese Phone Number",
  "description": "Detects Chinese phone numbers with +86 country code. Includes mobile (11 digits starting with 1) and landline formats.\n\nFormat: +86 1XX XXXX XXXX",
  "category_id": "personal",
  "severity": "medium",
  "profiles": [
    "production"
  ],
  "evaluation": {
    "evaluation_type": "pattern_match",
    "priority": 65,
    "target": "content",
    "pattern": {
      "pattern": "\\b(?:\\+86[\\s.-]?)?1[3-9]\\d{9}\\b",
      "engine": "regex"
    },
    "effect": {
      "type": "transform",
      "rationale": "verification",
      "transform": {
        "type": "tokenize",
        "params": {
          "prefix": "TEL",
          "reversible": false
        }
      },
      "message": "Chinese phone number tokenized for de-identification"
    }
  },
  "status": "active",
  "created_at": "2026-01-27T00:00:00Z",
  "regions": [
    "CN"
  ],
  "references": [
    {
      "note": "Based on OpenRedaction community patterns"
    },
    {
      "url": "https://github.com/openredact/openredact"
    }
  ],
  "modified_at": "2026-07-23T00:00:00Z",
  "modified_by": "claude-code"
}
