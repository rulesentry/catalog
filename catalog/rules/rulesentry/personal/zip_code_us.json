{
  "$schema": "https://schemas.rulesentry.io/v5/catalog/rule.schema.json",
  "id": "personal.zip_code_us",
  "qualified_id": "rulesentry.personal.zip_code_us",
  "publisher_id": "rulesentry",
  "type": "rule",
  "version": "4.0.0",
  "name": "US ZIP Code",
  "description": "Detects US ZIP codes in 5-digit (XXXXX) and ZIP+4 (XXXXX-XXXX) formats.\n\nFormats: XXXXX, XXXXX-XXXX\nNote: No lookahead/lookbehind in Rust regex crate. Character-class boundaries ([^0-9A-Za-z-]) used instead of \\b to prevent matching 5-digit sequences embedded in hyphenated identifiers (e.g. case numbers like 1:24-cv-08832-JRM). capture_groups:true narrows the transform span to group 1 only.",
  "category_id": "personal",
  "severity": "low",
  "profiles": [
    "ccpa",
    "production"
  ],
  "evaluation": {
    "evaluation_type": "pattern_match",
    "priority": 60,
    "target": "content",
    "pattern": {
      "pattern": "(?:^|[^0-9A-Za-z-])(\\d{5}(?:-\\d{4})?)(?:[^0-9A-Za-z-]|$)",
      "engine": "regex",
      "flags": {
        "capture_groups": true
      }
    },
    "effect": {
      "type": "transform",
      "rationale": "verification",
      "transform": {
        "type": "tokenize",
        "params": {
          "prefix": "ZIP",
          "reversible": false
        }
      },
      "message": "US ZIP code tokenized for de-identification"
    }
  },
  "status": "active",
  "created_at": "2026-01-27T00:00:00Z",
  "regions": [
    "US"
  ],
  "references": [
    {
      "note": "Based on OpenRedaction community patterns"
    },
    {
      "url": "https://github.com/openredact/openredact"
    }
  ],
  "modified_at": "2026-07-23T00:00:00Z",
  "modified_by": "claude-code"
}
